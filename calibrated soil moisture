// ================= MAIN =================
int main(void)
{
    WDTCTL = WDTPW | WDTHOLD;

    BCSCTL1 = CALBC1_1MHZ;
    DCOCTL  = CALDCO_1MHZ;

    uart_init();
    adc_init();

    P1DIR |= SOIL_PWR | BH_PWR | SHT_PWR;
    P1OUT &= ~(SOIL_PWR | BH_PWR | SHT_PWR);

    uart_print("\r\nSMART SENSOR SYSTEM START\r\n");

    int i;

    // ================= SOIL =================
    uart_print("\r\nSOIL SENSOR\r\n");

    P1OUT |= SOIL_PWR;
    delay_ms(300);

    for(i=0;i<SOIL_N;i++)
    {
        soil_buf[i] = soil_read();
        delay_ms(50);
    }

    for(i=0;i<20;i++)
    {
        unsigned int raw = soil_read();

        soil_buf[soil_index++] = raw;
        if(soil_index >= SOIL_N) soil_index = 0;

        unsigned int med = median5(soil_buf);
        unsigned int smooth = moving_average(med);
        int moisture = soil_to_percent(smooth);

        uart_print("Raw: ");
        uart_num(raw);

        uart_print(" Smooth: ");
        uart_num(smooth);

        uart_print(" Moisture: ");
        uart_num(moisture);
        uart_print(" %\r\n");

        delay_ms(500);
    }

    P1OUT &= ~SOIL_PWR;

    // ================= BH1750 =================
    uart_print("\r\nBH1750 SENSOR\r\n");

    P1OUT |= BH_PWR;
    delay_ms(500);

    for(i=0;i<30;i++)
    {
        unsigned int raw = bh1750_read();
        unsigned int lux = bh1750_process(raw);
        int percent = bh_to_percent(lux);

        uart_print("Raw: ");
        uart_num(raw);

        uart_print(" Lux: ");
        uart_num(lux);

        uart_print(" Lux%: ");
        uart_num(percent);
        uart_print(" %\r\n");

        delay_ms(300);
    }

    P1OUT &= ~BH_PWR;

    // ================= SHT3x =================
    uart_print("\r\nSHT3x SENSOR\r\n");

    P1OUT |= SHT_PWR;
    delay_ms(500);

    int t, h;
    sht3x_read(&t, &h);

    uart_print("Temp: ");
    uart_num(t);
    uart_print(" C\r\n");

    uart_print("Hum: ");
    uart_num(h);
    uart_print(" %\r\n");

    P1OUT &= ~SHT_PWR;

    uart_print("\r\nENTERING LPM3...\r\n");

    UCA0CTL1 |= UCSWRST;
    __bis_SR_register(LPM3_bits + GIE);

    while(1);
}
