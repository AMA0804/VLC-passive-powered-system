#include <msp430.h>
#include <stdint.h>

/* ============================================================
   FINAL 4-SENSOR SEQUENCING SYSTEM

   Sequence:
   1. Soil moisture sensor ON  -> Read -> Filter -> Calibrate -> OFF
   2. BH1750 light sensor ON   -> Read -> Filter -> Calibrate -> OFF
   3. SHT3X sensor ON          -> Read -> Filter -> OFF
   4. DS18B20 sensor always ON -> Read -> Average filter

   MCU assumed: MSP430G2553 / MSP430 LaunchPad
   Clock: 1 MHz
   UART TX only: P1.2, 9600 baud
   ============================================================ */

/* ================= FINAL PIN DEFINITIONS ================= */

#define SOIL_MOSFET        BIT0    // P1.0 -> Soil sensor BSS138 gate
#define BH1750_MOSFET      BIT1    // P1.1 -> BH1750 BSS138 gate
#define SHT3X_MOSFET       BIT4    // P1.4 -> SHT3X BSS138 gate

#define SOIL_ADC_BIT       BIT3    // P1.3 / A3
#define SOIL_ADC_CHANNEL   INCH_3

#define UART_TX_PIN        BIT2    // P1.2 TX only

#define I2C_SCL            BIT6    // P1.6
#define I2C_SDA            BIT7    // P1.7

/* DS18B20 is always powered. DATA pin changed to P1.5. */
#define DS18B20_PIN        BIT5    // P1.5 -> DS18B20 DATA
#define DS18B20_DIR        P1DIR
#define DS18B20_OUT        P1OUT
#define DS18B20_IN         P1IN
#define DS18B20_SEL        P1SEL
#define DS18B20_SEL2       P1SEL2
#define DS18B20_REN        P1REN

#define BH1750_ADDR_1      0x23
#define BH1750_ADDR_2      0x5C

#define SHT3X_ADDR_1       0x44
#define SHT3X_ADDR_2       0x45

#define I2C_TIMEOUT        60000

/* ================= SOIL CALIBRATION ================= */

#define SOIL_DRY_ADC       805     // Dry soil = 0.0%
#define SOIL_WET_ADC       602     // Wet soil = 100.0%

/* ================= FILTER SETTINGS ================= */

#define EMA_ALPHA_NUM      2       // alpha = 0.2
#define EMA_ALPHA_DEN      10

#define DS18B20_FILTER_SAMPLES       5
#define DS18B20_CAL_OFFSET_X100      0
#define DS18B20_ERROR_VALUE_X100    -99900

/* ================= DELAY ================= */

void delay_ms(uint16_t ms)
{
    while (ms--)
    {
        __delay_cycles(1000);       // 1 MHz clock
    }
}

/* ================= CLOCK ================= */

void clock_init(void)
{
    if (CALBC1_1MHZ == 0xFF)
    {
        while (1);
    }

    DCOCTL = 0;
    BCSCTL1 = CALBC1_1MHZ;
    DCOCTL = CALDCO_1MHZ;
}

/* ================= UART TX ONLY ================= */

void uart_init(void)
{
    /*
       IMPORTANT:
       P1.1 is BH1750 MOSFET gate.
       Do not use P1.1 as UART RX.
       Only P1.2 TX is enabled.
    */

    P1SEL  |= UART_TX_PIN;
    P1SEL2 |= UART_TX_PIN;

    UCA0CTL1 |= UCSWRST;
    UCA0CTL1 |= UCSSEL_2;

    UCA0BR0 = 104;     // 9600 baud @ 1 MHz
    UCA0BR1 = 0;
    UCA0MCTL = UCBRS0;

    UCA0CTL1 &= ~UCSWRST;
}

void uart_putc(char c)
{
    while (!(IFG2 & UCA0TXIFG));
    UCA0TXBUF = c;
}

void uart_puts(const char *s)
{
    while (*s)
    {
        uart_putc(*s++);
    }
}

void uart_print_uint32(uint32_t value)
{
    char buffer[11];
    uint8_t i = 0;

    if (value == 0)
    {
        uart_putc('0');
        return;
    }

    while (value > 0)
    {
        buffer[i++] = (value % 10) + '0';
        value /= 10;
    }

    while (i > 0)
    {
        uart_putc(buffer[--i]);
    }
}

void uart_print_int32(int32_t value)
{
    if (value < 0)
    {
        uart_putc('-');
        value = -value;
    }

    uart_print_uint32((uint32_t)value);
}

void uart_print_int_x10(int32_t value_x10)
{
    if (value_x10 < 0)
    {
        uart_putc('-');
        value_x10 = -value_x10;
    }

    uart_print_uint32((uint32_t)(value_x10 / 10));
    uart_putc('.');
    uart_print_uint32((uint32_t)(value_x10 % 10));
}

void uart_print_uint_x10(uint32_t value_x10)
{
    uart_print_uint32(value_x10 / 10);
    uart_putc('.');
    uart_print_uint32(value_x10 % 10);
}

void uart_print_temp_x100(int32_t temp_x100)
{
    int32_t abs_temp;

    if (temp_x100 < 0)
    {
        uart_putc('-');
        abs_temp = -temp_x100;
    }
    else
    {
        abs_temp = temp_x100;
    }

    uart_print_uint32((uint32_t)(abs_temp / 100));
    uart_putc('.');

    if ((abs_temp % 100) < 10)
    {
        uart_putc('0');
    }

    uart_print_uint32((uint32_t)(abs_temp % 100));
}

/* ================= SENSOR POWER CONTROL ================= */

void sensor_power_init(void)
{
    P1SEL  &= ~(SOIL_MOSFET | BH1750_MOSFET | SHT3X_MOSFET);
    P1SEL2 &= ~(SOIL_MOSFET | BH1750_MOSFET | SHT3X_MOSFET);

    P1OUT &= ~(SOIL_MOSFET | BH1750_MOSFET | SHT3X_MOSFET);
    P1DIR |=  (SOIL_MOSFET | BH1750_MOSFET | SHT3X_MOSFET);
}

void all_switched_sensors_off(void)
{
    P1OUT &= ~(SOIL_MOSFET | BH1750_MOSFET | SHT3X_MOSFET);
}

void soil_power_on(void)
{
    P1OUT |= SOIL_MOSFET;
}

void soil_power_off(void)
{
    P1OUT &= ~SOIL_MOSFET;
}

void bh1750_power_on(void)
{
    P1OUT |= BH1750_MOSFET;
}

void bh1750_power_off(void)
{
    P1OUT &= ~BH1750_MOSFET;
}

void sht3x_power_on(void)
{
    P1OUT |= SHT3X_MOSFET;
}

void sht3x_power_off(void)
{
    P1OUT &= ~SHT3X_MOSFET;
}

/* ================= ADC ================= */

void adc_init(void)
{
    ADC10CTL0 &= ~ENC;

    ADC10CTL1 = SOIL_ADC_CHANNEL;
    ADC10CTL0 = SREF_0 | ADC10SHT_2 | ADC10ON;

    ADC10AE0 |= SOIL_ADC_BIT;
}

uint16_t adc_read_once(void)
{
    ADC10CTL0 |= ENC | ADC10SC;

    while (ADC10CTL1 & ADC10BUSY);

    ADC10CTL0 &= ~ENC;

    return ADC10MEM;
}

/* ================= I2C ================= */

void i2c_release_pins(void)
{
    UCB0CTL1 |= UCSWRST;

    P1SEL  &= ~(I2C_SCL | I2C_SDA);
    P1SEL2 &= ~(I2C_SCL | I2C_SDA);

    P1DIR &= ~(I2C_SCL | I2C_SDA);
    P1REN &= ~(I2C_SCL | I2C_SDA);
}

void i2c_init(void)
{
    UCB0CTL1 |= UCSWRST;

    P1SEL  |= I2C_SCL | I2C_SDA;
    P1SEL2 |= I2C_SCL | I2C_SDA;

    UCB0CTL0 = UCMST | UCMODE_3 | UCSYNC;
    UCB0CTL1 = UCSSEL_2 | UCSWRST;

    UCB0BR0 = 10;      // 100 kHz @ 1 MHz
    UCB0BR1 = 0;

    UCB0STAT &= ~UCNACKIFG;

    UCB0CTL1 &= ~UCSWRST;
}

void i2c_bus_recover(void)
{
    uint8_t i;

    i2c_release_pins();

    P1DIR |= I2C_SCL;
    P1DIR &= ~I2C_SDA;

    for (i = 0; i < 9; i++)
    {
        P1OUT &= ~I2C_SCL;
        delay_ms(1);

        P1OUT |= I2C_SCL;
        delay_ms(1);
    }

    P1DIR &= ~(I2C_SCL | I2C_SDA);
}

uint8_t i2c_write(uint8_t address, uint8_t *data, uint8_t length)
{
    uint8_t i;
    uint16_t timeout;

    while (UCB0CTL1 & UCTXSTP);

    UCB0STAT &= ~UCNACKIFG;
    UCB0I2CSA = address;

    UCB0CTL1 |= UCTR | UCTXSTT;

    for (i = 0; i < length; i++)
    {
        timeout = I2C_TIMEOUT;

        while (!(IFG2 & UCB0TXIFG))
        {
            if (UCB0STAT & UCNACKIFG)
            {
                UCB0STAT &= ~UCNACKIFG;
                UCB0CTL1 |= UCTXSTP;
                return 0;
            }

            if (--timeout == 0)
            {
                UCB0CTL1 |= UCTXSTP;
                return 0;
            }
        }

        UCB0TXBUF = data[i];
    }

    timeout = I2C_TIMEOUT;

    while (!(IFG2 & UCB0TXIFG))
    {
        if (UCB0STAT & UCNACKIFG)
        {
            UCB0STAT &= ~UCNACKIFG;
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }

        if (--timeout == 0)
        {
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }
    }

    UCB0CTL1 |= UCTXSTP;

    timeout = I2C_TIMEOUT;
    while ((UCB0CTL1 & UCTXSTP) && timeout--);

    return 1;
}

uint8_t i2c_read(uint8_t address, uint8_t *data, uint8_t length)
{
    uint8_t i;
    uint16_t timeout;

    if (length == 0)
    {
        return 0;
    }

    while (UCB0CTL1 & UCTXSTP);

    UCB0STAT &= ~UCNACKIFG;
    UCB0I2CSA = address;

    UCB0CTL1 &= ~UCTR;
    UCB0CTL1 |= UCTXSTT;

    timeout = I2C_TIMEOUT;

    while (UCB0CTL1 & UCTXSTT)
    {
        if (UCB0STAT & UCNACKIFG)
        {
            UCB0STAT &= ~UCNACKIFG;
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }

        if (--timeout == 0)
        {
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }
    }

    for (i = 0; i < length; i++)
    {
        if (i == length - 1)
        {
            UCB0CTL1 |= UCTXSTP;
        }

        timeout = I2C_TIMEOUT;

        while (!(IFG2 & UCB0RXIFG))
        {
            if (--timeout == 0)
            {
                UCB0CTL1 |= UCTXSTP;
                return 0;
            }
        }

        data[i] = UCB0RXBUF;
    }

    timeout = I2C_TIMEOUT;
    while ((UCB0CTL1 & UCTXSTP) && timeout--);

    return 1;
}

/* ============================================================
   SOIL MOISTURE SENSOR
   ============================================================ */

uint16_t read_soil_adc_filtered(void)
{
    uint8_t i;
    uint16_t adc_value;
    uint16_t min_value = 1023;
    uint16_t max_value = 0;
    uint32_t sum = 0;

    for (i = 0; i < 5; i++)
    {
        adc_read_once();
        delay_ms(5);
    }

    for (i = 0; i < 15; i++)
    {
        adc_value = adc_read_once();

        sum += adc_value;

        if (adc_value < min_value)
        {
            min_value = adc_value;
        }

        if (adc_value > max_value)
        {
            max_value = adc_value;
        }

        delay_ms(10);
    }

    sum = sum - min_value - max_value;

    return (uint16_t)(sum / 13);
}

uint32_t calibrate_soil_moisture_x10(uint16_t adc_value)
{
    int32_t moisture_x10;
    int32_t dry_adc = (int32_t)SOIL_DRY_ADC;
    int32_t wet_adc = (int32_t)SOIL_WET_ADC;
    int32_t adc = (int32_t)adc_value;

    moisture_x10 = ((dry_adc - adc) * 1000) / (dry_adc - wet_adc);

    if (moisture_x10 < 0)
    {
        moisture_x10 = 0;
    }

    if (moisture_x10 > 1000)
    {
        moisture_x10 = 1000;
    }

    return (uint32_t)moisture_x10;
}

uint32_t ema_filter_soil_x10(uint32_t new_moisture_x10)
{
    static uint8_t first_run = 1;
    static int32_t filtered_moisture_x10 = 0;
    int32_t error;

    if (first_run)
    {
        filtered_moisture_x10 = (int32_t)new_moisture_x10;
        first_run = 0;
    }
    else
    {
        error = (int32_t)new_moisture_x10 - filtered_moisture_x10;

        filtered_moisture_x10 = filtered_moisture_x10 +
                                ((EMA_ALPHA_NUM * error) / EMA_ALPHA_DEN);
    }

    if (filtered_moisture_x10 < 0)
    {
        filtered_moisture_x10 = 0;
    }

    if (filtered_moisture_x10 > 1000)
    {
        filtered_moisture_x10 = 1000;
    }

    return (uint32_t)filtered_moisture_x10;
}

uint8_t soil_read_final(uint16_t *raw_adc,
                        uint32_t *calibrated_moisture_x10,
                        uint32_t *final_moisture_x10)
{
    uint16_t adc_filtered;
    uint32_t moisture_calibrated;

    i2c_release_pins();
    all_switched_sensors_off();
    delay_ms(50);

    soil_power_on();
    delay_ms(800);

    adc_filtered = read_soil_adc_filtered();
    moisture_calibrated = calibrate_soil_moisture_x10(adc_filtered);

    *raw_adc = adc_filtered;
    *calibrated_moisture_x10 = moisture_calibrated;
    *final_moisture_x10 = ema_filter_soil_x10(moisture_calibrated);

    soil_power_off();

    return 1;
}

/* ============================================================
   BH1750 LIGHT SENSOR
   ============================================================ */

uint8_t bh1750_read_lux_x10(uint8_t address, uint32_t *lux_x10)
{
    uint8_t cmd;
    uint8_t data[2];
    uint16_t raw;

    cmd = 0x20;      // One-time high resolution mode

    if (!i2c_write(address, &cmd, 1))
    {
        return 0;
    }

    delay_ms(180);

    if (!i2c_read(address, data, 2))
    {
        return 0;
    }

    raw = ((uint16_t)data[0] << 8) | data[1];

    *lux_x10 = ((uint32_t)raw * 100UL) / 12UL;

    return 1;
}

uint32_t trimmed_mean5_u32(uint32_t a,
                           uint32_t b,
                           uint32_t c,
                           uint32_t d,
                           uint32_t e)
{
    uint32_t arr[5];
    uint8_t i, j;
    uint32_t temp;

    arr[0] = a;
    arr[1] = b;
    arr[2] = c;
    arr[3] = d;
    arr[4] = e;

    for (i = 0; i < 4; i++)
    {
        for (j = i + 1; j < 5; j++)
        {
            if (arr[j] < arr[i])
            {
                temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }
    }

    return (arr[1] + arr[2] + arr[3]) / 3;
}

uint32_t calibrate_bh1750_lux_x10(uint32_t bh1750_lux_x10)
{
    int32_t x;
    int32_t y;

    const int32_t X1 = 8663;
    const int32_t Y1 = 6200;

    const int32_t X2 = 14649;
    const int32_t Y2 = 10700;

    const int32_t X3 = 39635;
    const int32_t Y3 = 29000;

    const int32_t X4 = 67785;
    const int32_t Y4 = 49000;

    const int32_t X5 = 79020;
    const int32_t Y5 = 60000;

    const int32_t X6 = 94873;
    const int32_t Y6 = 80000;

    x = (int32_t)bh1750_lux_x10;

    if (x <= X1)
    {
        y = (x * Y1) / X1;
    }
    else if (x <= X2)
    {
        y = Y1 + (((x - X1) * (Y2 - Y1)) / (X2 - X1));
    }
    else if (x <= X3)
    {
        y = Y2 + (((x - X2) * (Y3 - Y2)) / (X3 - X2));
    }
    else if (x <= X4)
    {
        y = Y3 + (((x - X3) * (Y4 - Y3)) / (X4 - X3));
    }
    else if (x <= X5)
    {
        y = Y4 + (((x - X4) * (Y5 - Y4)) / (X5 - X4));
    }
    else
    {
        y = Y5 + (((x - X5) * (Y6 - Y5)) / (X6 - X5));
    }

    if (y < 0)
    {
        y = 0;
    }

    return (uint32_t)y;
}

uint32_t ema_filter_lux_x10(uint32_t new_lux_x10)
{
    static uint8_t first_run = 1;
    static int32_t filtered_lux_x10 = 0;
    int32_t error;

    if (first_run)
    {
        filtered_lux_x10 = (int32_t)new_lux_x10;
        first_run = 0;
    }
    else
    {
        error = (int32_t)new_lux_x10 - filtered_lux_x10;

        filtered_lux_x10 = filtered_lux_x10 +
                           ((EMA_ALPHA_NUM * error) / EMA_ALPHA_DEN);
    }

    if (filtered_lux_x10 < 0)
    {
        filtered_lux_x10 = 0;
    }

    return (uint32_t)filtered_lux_x10;
}

uint8_t bh1750_read_final(uint8_t address,
                          uint32_t *raw_filtered_lux_x10,
                          uint32_t *calibrated_lux_x10,
                          uint32_t *final_lux_x10)
{
    uint32_t dummy;
    uint32_t r1, r2, r3, r4, r5;
    uint32_t raw_filtered;
    uint32_t calibrated;

    if (!bh1750_read_lux_x10(address, &dummy))
    {
        return 0;
    }

    delay_ms(50);

    if (!bh1750_read_lux_x10(address, &r1)) return 0;
    delay_ms(50);

    if (!bh1750_read_lux_x10(address, &r2)) return 0;
    delay_ms(50);

    if (!bh1750_read_lux_x10(address, &r3)) return 0;
    delay_ms(50);

    if (!bh1750_read_lux_x10(address, &r4)) return 0;
    delay_ms(50);

    if (!bh1750_read_lux_x10(address, &r5)) return 0;

    raw_filtered = trimmed_mean5_u32(r1, r2, r3, r4, r5);
    calibrated = calibrate_bh1750_lux_x10(raw_filtered);

    *raw_filtered_lux_x10 = raw_filtered;
    *calibrated_lux_x10 = calibrated;
    *final_lux_x10 = ema_filter_lux_x10(calibrated);

    return 1;
}

uint8_t bh1750_sequence_read(uint32_t *raw_lux_x10,
                             uint32_t *calibrated_lux_x10,
                             uint32_t *final_lux_x10)
{
    uint8_t ok = 0;

    i2c_release_pins();
    all_switched_sensors_off();
    delay_ms(50);

    bh1750_power_on();
    delay_ms(300);

    i2c_bus_recover();
    i2c_init();

    if (bh1750_read_final(BH1750_ADDR_1,
                          raw_lux_x10,
                          calibrated_lux_x10,
                          final_lux_x10))
    {
        ok = 1;
    }
    else
    {
        i2c_bus_recover();
        i2c_init();

        if (bh1750_read_final(BH1750_ADDR_2,
                              raw_lux_x10,
                              calibrated_lux_x10,
                              final_lux_x10))
        {
            ok = 1;
        }
    }

    i2c_release_pins();
    bh1750_power_off();

    return ok;
}

/* ============================================================
   SHT3X TEMPERATURE AND HUMIDITY SENSOR
   ============================================================ */

uint8_t sht3x_crc8(uint8_t *data, uint8_t length)
{
    uint8_t crc = 0xFF;
    uint8_t i;
    uint8_t bit;

    for (i = 0; i < length; i++)
    {
        crc ^= data[i];

        for (bit = 0; bit < 8; bit++)
        {
            if (crc & 0x80)
            {
                crc = (crc << 1) ^ 0x31;
            }
            else
            {
                crc <<= 1;
            }
        }
    }

    return crc;
}

uint8_t sht3x_read_temp_humidity(uint8_t address,
                                 int32_t *temperature_c_x10,
                                 uint32_t *humidity_x10)
{
    uint8_t cmd[2];
    uint8_t data[6];
    uint16_t raw_temp;
    uint16_t raw_hum;

    cmd[0] = 0x24;
    cmd[1] = 0x00;

    if (!i2c_write(address, cmd, 2))
    {
        return 0;
    }

    delay_ms(20);

    if (!i2c_read(address, data, 6))
    {
        return 0;
    }

    if (sht3x_crc8(&data[0], 2) != data[2])
    {
        return 0;
    }

    if (sht3x_crc8(&data[3], 2) != data[5])
    {
        return 0;
    }

    raw_temp = ((uint16_t)data[0] << 8) | data[1];
    raw_hum  = ((uint16_t)data[3] << 8) | data[4];

    *temperature_c_x10 = -450 + (((int32_t)1750 * raw_temp) / 65535);
    *humidity_x10 = ((uint32_t)1000 * raw_hum) / 65535;

    return 1;
}

