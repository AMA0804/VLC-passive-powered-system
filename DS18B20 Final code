#include <msp430.h>
#include <stdint.h>

// DS18B20 connected to P1.4
#define DS18B20_PIN     BIT4
#define DS18B20_DIR     P1DIR
#define DS18B20_OUT     P1OUT
#define DS18B20_IN      P1IN
#define DS18B20_SEL     P1SEL
#define DS18B20_SEL2    P1SEL2

#define TEMP_FILTER_SAMPLES        5
#define DS18B20_CAL_OFFSET_X100    0
#define TEMP_ERROR_VALUE_X100     -99900

void uart_init(void)
{
    P1SEL  |= BIT1 | BIT2;
    P1SEL2 |= BIT1 | BIT2;

    UCA0CTL1 |= UCSWRST;
    UCA0CTL1 |= UCSSEL_2;

    UCA0BR0 = 104;
    UCA0BR1 = 0;
    UCA0MCTL = UCBRS0;

    UCA0CTL1 &= ~UCSWRST;
}

void uart_putc(char c)
{
    while (!(IFG2 & UCA0TXIFG));
    UCA0TXBUF = c;
}

void uart_print(const char *str)
{
    while (*str)
    {
        uart_putc(*str++);
    }
}

void uart_print_int(int32_t num)
{
    char buffer[12];
    int i = 0;

    if (num == 0)
    {
        uart_putc('0');
        return;
    }

    if (num < 0)
    {
        uart_putc('-');
        num = -num;
    }

    while (num > 0)
    {
        buffer[i++] = (num % 10) + '0';
        num /= 10;
    }

    while (i > 0)
    {
        uart_putc(buffer[--i]);
    }
}

void uart_print_temp_x100(int32_t temp_x100)
{
    int32_t abs_temp;

    if (temp_x100 < 0)
    {
        uart_putc('-');
        abs_temp = -temp_x100;
    }
    else
    {
        abs_temp = temp_x100;
    }

    uart_print_int(abs_temp / 100);
    uart_putc('.');

    if ((abs_temp % 100) < 10)
    {
        uart_putc('0');
    }

    uart_print_int(abs_temp % 100);
}

void ds18b20_low(void)
{
    DS18B20_OUT &= ~DS18B20_PIN;
    DS18B20_DIR |= DS18B20_PIN;
}

void ds18b20_release(void)
{
    DS18B20_DIR &= ~DS18B20_PIN;
}

uint8_t ds18b20_read_pin(void)
{
    return (DS18B20_IN & DS18B20_PIN) ? 1 : 0;
}

uint8_t ds18b20_reset(void)
{
    uint8_t presence;

    ds18b20_low();
    __delay_cycles(480);

    ds18b20_release();
    __delay_cycles(70);

    presence = !ds18b20_read_pin();

    __delay_cycles(410);

    return presence;
}

void ds18b20_write_bit(uint8_t bit)
{
    if (bit)
    {
        ds18b20_low();
        __delay_cycles(6);
        ds18b20_release();
        __delay_cycles(64);
    }
    else
    {
        ds18b20_low();
        __delay_cycles(60);
        ds18b20_release();
        __delay_cycles(10);
    }
}

uint8_t ds18b20_read_bit(void)
{
    uint8_t bit;

    ds18b20_low();
    __delay_cycles(6);

    ds18b20_release();
    __delay_cycles(9);

    bit = ds18b20_read_pin();

    __delay_cycles(55);

    return bit;
}

void ds18b20_write_byte(uint8_t data)
{
    uint8_t i;

    for (i = 0; i < 8; i++)
    {
        ds18b20_write_bit(data & 0x01);
        data >>= 1;
    }
}

uint8_t ds18b20_read_byte(void)
{
    uint8_t i;
    uint8_t data = 0;

    for (i = 0; i < 8; i++)
    {
        if (ds18b20_read_bit())
        {
            data |= (1 << i);
        }
    }

    return data;
}

uint8_t ds18b20_crc8(uint8_t *data, uint8_t len)
{
    uint8_t crc = 0;
    uint8_t i, j;

    for (i = 0; i < len; i++)
    {
        crc ^= data[i];

        for (j = 0; j < 8; j++)
        {
            if (crc & 0x01)
            {
                crc = (crc >> 1) ^ 0x8C;
            }
            else
            {
                crc >>= 1;
            }
        }
    }

    return crc;
}

uint8_t ds18b20_read_raw_temperature(int16_t *raw_temp)
{
    uint8_t scratchpad[9];
    uint8_t i;

    if (!ds18b20_reset())
    {
        return 0;
    }

    ds18b20_write_byte(0xCC);
    ds18b20_write_byte(0x44);

    __delay_cycles(750000);

    if (!ds18b20_reset())
    {
        return 0;
    }

    ds18b20_write_byte(0xCC);
    ds18b20_write_byte(0xBE);

    for (i = 0; i < 9; i++)
    {
        scratchpad[i] = ds18b20_read_byte();
    }

    if (ds18b20_crc8(scratchpad, 8) != scratchpad[8])
    {
        return 2;
    }

    *raw_temp = (int16_t)((scratchpad[1] << 8) | scratchpad[0]);

    return 1;
}

int32_t ds18b20_raw_to_x100(int16_t raw)
{
    return ((int32_t)raw * 100) / 16;
}

int32_t ds18b20_get_filtered_temperature_x100(void)
{
    uint8_t i;
    uint8_t status;
    uint8_t valid_count = 0;

    int16_t raw_temperature;
    int32_t temp_x100;
    int32_t sum_x100 = 0;
    int32_t average_x100;
    int32_t final_x100;

    for (i = 0; i < TEMP_FILTER_SAMPLES; i++)
    {
        status = ds18b20_read_raw_temperature(&raw_temperature);

        if (status == 1)
        {
            temp_x100 = ds18b20_raw_to_x100(raw_temperature);
            sum_x100 += temp_x100;
            valid_count++;
        }
        else if (status == 0)
        {
            uart_print("Sample failed: DS18B20 not detected\r\n");
        }
        else if (status == 2)
        {
            uart_print("Sample failed: CRC error\r\n");
        }

        __delay_cycles(100000);
    }

    if (valid_count == 0)
    {
        return TEMP_ERROR_VALUE_X100;
    }

    average_x100 = sum_x100 / valid_count;
    final_x100 = average_x100 + DS18B20_CAL_OFFSET_X100;

    return final_x100;
}

int main(void)
{
    WDTCTL = WDTPW | WDTHOLD;

    if (CALBC1_1MHZ == 0xFF)
    {
        while (1);
    }

    DCOCTL = 0;
    BCSCTL1 = CALBC1_1MHZ;
    DCOCTL = CALDCO_1MHZ;

    uart_init();

    // Configure P1.4 as normal GPIO for DS18B20
    DS18B20_SEL &= ~DS18B20_PIN;
    DS18B20_SEL2 &= ~DS18B20_PIN;

    ds18b20_release();

    uart_print("\r\nDS18B20 Soil Temperature Sensor Test\r\n");
    uart_print("DATA pin: P1.4\r\n");
    uart_print("Filter: Average of 5 valid samples\r\n");
    uart_print("Calibration offset: 0.00 C\r\n");
    uart_print("--------------------------------------\r\n");

    while (1)
    {
        int32_t soil_temp_x100;

        soil_temp_x100 = ds18b20_get_filtered_temperature_x100();

        if (soil_temp_x100 == TEMP_ERROR_VALUE_X100)
        {
            uart_print("Final result: DS18B20 read error\r\n");
        }
        else
        {
            uart_print("Filtered soil temperature = ");
            uart_print_temp_x100(soil_temp_x100);
            uart_print(" C\r\n");
        }

        uart_print("--------------------------------------\r\n");

        __delay_cycles(1000000);
    }
}
