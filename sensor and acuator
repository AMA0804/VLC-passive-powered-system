#include <msp430.h>
#include <stdint.h>

/* ============================================================
   FINAL CONTROL NODE CODE
   Plant: Saffron
   MCU: MSP430G2553
   Clock: 1 MHz
   Sleep: LPM3, wake every 5 minutes using Timer_A + VLO
   ============================================================ */

/* ================= SN74HC595 ACTUATOR PINS ================= */

#define SR_DATA            BIT0    // P2.0 -> SN74HC595 pin 14 / DS
#define SR_CLOCK           BIT1    // P2.1 -> SN74HC595 pin 11 / SH_CP
#define SR_LATCH           BIT2    // P2.2 -> SN74HC595 pin 12 / ST_CP
#define SR_OE              BIT3    // P2.3 -> SN74HC595 pin 13 / OE, active LOW

/* ================= ACTUATOR OUTPUT MAPPING ================= */

#define FAN_Q_BIT          BIT1    // Q1 / pin 1  -> Fan
#define SOLENOID_Q_BIT     BIT2    // Q2 / pin 2  -> Solenoid valve
#define HUMIDIFIER_Q_BIT   BIT3    // Q3 / pin 3  -> Humidifier
#define PELTIER_Q_BIT      BIT4    // Q4 / pin 4  -> Peltier through TC4420
#define PUMP_Q_BIT         BIT5    // Q5 / pin 5  -> Peltier pump

/* ================= SENSOR PINS ================= */

#define SOIL_MOSFET        BIT4    // P1.4 -> Soil sensor BSS138 gate
#define BH1750_MOSFET      BIT4    // P2.4 -> BH1750 BSS138 gate
#define SHT3X_MOSFET       BIT5    // P2.5 -> SHT3X BSS138 gate

#define SOIL_ADC_BIT       BIT3    // P1.3 / A3
#define SOIL_ADC_CHANNEL   INCH_3

#define DS18B20_PIN        BIT5    // P1.5 -> DS18B20 DATA

#define UART_TX_PIN        BIT2    // P1.2 UART TX only

#define I2C_SCL            BIT6    // P1.6
#define I2C_SDA            BIT7    // P1.7

/* ================= I2C ADDRESSES ================= */

#define BH1750_ADDR_1      0x23
#define BH1750_ADDR_2      0x5C

#define SHT3X_ADDR_1       0x44
#define SHT3X_ADDR_2       0x45

#define I2C_TIMEOUT        60000

/* ================= SAFFRON THRESHOLDS ================= */

/* Fan thresholds, x10 */
#define FAN_TEMP_ON_X10        250    // 25.0 C
#define FAN_TEMP_OFF_X10       230    // 23.0 C
#define FAN_RH_ON_X10          800    // 80.0 %RH
#define FAN_RH_OFF_X10         750    // 75.0 %RH

/* Humidifier thresholds, x10 */
#define HUM_RH_ON_X10          600    // 60.0 %RH
#define HUM_RH_OFF_X10         650    // 65.0 %RH

/* Soil moisture thresholds, x10 */
#define SOIL_LOW_X10           250    // 25.0 %
#define SOIL_HIGH_X10          450    // 45.0 %

/* Soil moisture calibration */
#define SOIL_DRY_ADC           805    // dry = 0.0 %
#define SOIL_WET_ADC           602    // wet = 100.0 %

/* Peltier thresholds */
#define PELTIER_AIR_ON_X10     250    // 25.0 C
#define PELTIER_AIR_OFF_X10    230    // 23.0 C

#define PELTIER_SOIL_ON_X100   1800   // 18.00 C
#define PELTIER_SOIL_OFF_X100  1600   // 16.00 C

/* Timing */
#define SOLENOID_PULSE_MS              5000    // 5 seconds
#define IRRIGATION_LOCKOUT_CYCLES      6       // 6 x 5 min = 30 min

#define PUMP_PRE_RUN_MS                3000    // pump ON before peltier
#define PUMP_AFTER_RUN_MS              30000   // pump after-run after peltier OFF

/* Sleep */
#define ACLK_FREQ_HZ                   12000UL // VLO approximate
#define SLEEP_SECONDS                  300     // 5 minutes

/* ================= GLOBAL VARIABLES ================= */

volatile uint16_t sleep_counter = 0;

uint8_t shift_register_state = 0x00;

uint8_t fan_state = 0;
uint8_t humidifier_state = 0;
uint8_t solenoid_state = 0;
uint8_t peltier_state = 0;
uint8_t pump_state = 0;

uint8_t irrigation_lockout_counter = 0;

/* ================= BASIC DELAY ================= */

void delay_ms(uint16_t ms)
{
    while (ms--)
    {
        __delay_cycles(1000);
    }
}

/* ================= CLOCK ================= */

void clock_init(void)
{
    if (CALBC1_1MHZ != 0xFF)
    {
        DCOCTL = 0;
        BCSCTL1 = CALBC1_1MHZ;
        DCOCTL = CALDCO_1MHZ;
    }
}

/* ================= UART ================= */

void uart_init(void)
{
    P1SEL  |= UART_TX_PIN;
    P1SEL2 |= UART_TX_PIN;

    UCA0CTL1 |= UCSWRST;
    UCA0CTL1 |= UCSSEL_2;

    UCA0BR0 = 104;
    UCA0BR1 = 0;
    UCA0MCTL = UCBRS0;

    UCA0CTL1 &= ~UCSWRST;
}

void uart_putc(char c)
{
    while (!(IFG2 & UCA0TXIFG));
    UCA0TXBUF = c;
}

void uart_puts(const char *s)
{
    while (*s)
    {
        uart_putc(*s++);
    }
}

void uart_print_uint32(uint32_t value)
{
    char buffer[11];
    uint8_t i = 0;

    if (value == 0)
    {
        uart_putc('0');
        return;
    }

    while (value > 0)
    {
        buffer[i++] = (value % 10) + '0';
        value /= 10;
    }

    while (i > 0)
    {
        uart_putc(buffer[--i]);
    }
}

void uart_print_int_x10(int32_t value_x10)
{
    if (value_x10 < 0)
    {
        uart_putc('-');
        value_x10 = -value_x10;
    }

    uart_print_uint32((uint32_t)(value_x10 / 10));
    uart_putc('.');
    uart_print_uint32((uint32_t)(value_x10 % 10));
}

void uart_print_uint_x10(uint32_t value_x10)
{
    uart_print_uint32(value_x10 / 10);
    uart_putc('.');
    uart_print_uint32(value_x10 % 10);
}

void uart_print_int_x100(int32_t value_x100)
{
    uint32_t abs_value;

    if (value_x100 < 0)
    {
        uart_putc('-');
        abs_value = (uint32_t)(-value_x100);
    }
    else
    {
        abs_value = (uint32_t)value_x100;
    }

    uart_print_uint32(abs_value / 100);
    uart_putc('.');

    if ((abs_value % 100) < 10)
    {
        uart_putc('0');
    }

    uart_print_uint32(abs_value % 100);
}

/* ================= SN74HC595 FUNCTIONS ================= */

void shift_register_init(void)
{
    P2SEL  &= ~(SR_DATA | SR_CLOCK | SR_LATCH | SR_OE);
    P2SEL2 &= ~(SR_DATA | SR_CLOCK | SR_LATCH | SR_OE);

    P2OUT &= ~(SR_DATA | SR_CLOCK | SR_LATCH);
    P2OUT |= SR_OE;     // OE HIGH = outputs disabled first

    P2DIR |= (SR_DATA | SR_CLOCK | SR_LATCH | SR_OE);
}

void shift_register_enable_outputs(void)
{
    P2OUT &= ~SR_OE;    // OE LOW = outputs enabled
}

void shift_register_write(uint8_t value)
{
    uint8_t i;

    P2OUT &= ~SR_LATCH;

    for (i = 0; i < 8; i++)
    {
        if (value & 0x80)
        {
            P2OUT |= SR_DATA;
        }
        else
        {
            P2OUT &= ~SR_DATA;
        }

        P2OUT |= SR_CLOCK;
        __delay_cycles(5);
        P2OUT &= ~SR_CLOCK;

        value <<= 1;
    }

    P2OUT |= SR_LATCH;
    __delay_cycles(5);
    P2OUT &= ~SR_LATCH;
}

void actuator_update(void)
{
    shift_register_write(shift_register_state);
}

/* ================= ACTUATOR CONTROL ================= */

void fan_on(void)
{
    shift_register_state |= FAN_Q_BIT;
    actuator_update();
    fan_state = 1;
}

void fan_off(void)
{
    shift_register_state &= ~FAN_Q_BIT;
    actuator_update();
    fan_state = 0;
}

void humidifier_on(void)
{
    shift_register_state |= HUMIDIFIER_Q_BIT;
    actuator_update();
    humidifier_state = 1;
}

void humidifier_off(void)
{
    shift_register_state &= ~HUMIDIFIER_Q_BIT;
    actuator_update();
    humidifier_state = 0;
}

void solenoid_on(void)
{
    shift_register_state |= SOLENOID_Q_BIT;
    actuator_update();
    solenoid_state = 1;
}

void solenoid_off(void)
{
    shift_register_state &= ~SOLENOID_Q_BIT;
    actuator_update();
    solenoid_state = 0;
}

void pump_on(void)
{
    shift_register_state |= PUMP_Q_BIT;
    actuator_update();
    pump_state = 1;
}

void pump_off(void)
{
    shift_register_state &= ~PUMP_Q_BIT;
    actuator_update();
    pump_state = 0;
}

void peltier_on(void)
{
    shift_register_state |= PELTIER_Q_BIT;
    actuator_update();
    peltier_state = 1;
}

void peltier_off(void)
{
    shift_register_state &= ~PELTIER_Q_BIT;
    actuator_update();
    peltier_state = 0;
}

void all_actuators_off(void)
{
    shift_register_state = 0x00;
    actuator_update();

    fan_state = 0;
    humidifier_state = 0;
    solenoid_state = 0;
    peltier_state = 0;
    pump_state = 0;
}

/* ================= SENSOR POWER ================= */

void sensor_power_init(void)
{
    /* P1.4 soil MOSFET */
    P1SEL  &= ~SOIL_MOSFET;
    P1SEL2 &= ~SOIL_MOSFET;
    P1OUT &= ~SOIL_MOSFET;
    P1DIR |= SOIL_MOSFET;

    /* P2.4 BH1750 MOSFET, P2.5 SHT3X MOSFET */
    P2SEL  &= ~(BH1750_MOSFET | SHT3X_MOSFET);
    P2SEL2 &= ~(BH1750_MOSFET | SHT3X_MOSFET);
    P2OUT &= ~(BH1750_MOSFET | SHT3X_MOSFET);
    P2DIR |=  (BH1750_MOSFET | SHT3X_MOSFET);

    /* DS18B20 pin released */
    P1SEL  &= ~DS18B20_PIN;
    P1SEL2 &= ~DS18B20_PIN;
    P1DIR &= ~DS18B20_PIN;
}

void all_sensors_off(void)
{
    P1OUT &= ~SOIL_MOSFET;
    P2OUT &= ~(BH1750_MOSFET | SHT3X_MOSFET);
}

void soil_power_on(void)
{
    P1OUT |= SOIL_MOSFET;
}

void soil_power_off(void)
{
    P1OUT &= ~SOIL_MOSFET;
}

void bh1750_power_on(void)
{
    P2OUT |= BH1750_MOSFET;
}

void bh1750_power_off(void)
{
    P2OUT &= ~BH1750_MOSFET;
}

void sht3x_power_on(void)
{
    P2OUT |= SHT3X_MOSFET;
}

void sht3x_power_off(void)
{
    P2OUT &= ~SHT3X_MOSFET;
}

/* ================= ADC ================= */

void adc_init(void)
{
    ADC10CTL0 &= ~ENC;

    ADC10CTL1 = SOIL_ADC_CHANNEL;
    ADC10CTL0 = SREF_0 | ADC10SHT_2 | ADC10ON;

    ADC10AE0 |= SOIL_ADC_BIT;
}

void adc_disable(void)
{
    ADC10CTL0 &= ~ENC;
    ADC10CTL0 &= ~ADC10ON;
}

uint16_t adc_read_once(void)
{
    ADC10CTL0 |= ENC | ADC10SC;

    while (ADC10CTL1 & ADC10BUSY);

    ADC10CTL0 &= ~ENC;

    return ADC10MEM;
}

/* ================= SOIL SENSOR ================= */

uint16_t read_soil_adc_filtered(void)
{
    uint8_t i;
    uint16_t adc_value;
    uint16_t min_value = 1023;
    uint16_t max_value = 0;
    uint32_t sum = 0;

    for (i = 0; i < 5; i++)
    {
        adc_read_once();
        delay_ms(10);
    }

    for (i = 0; i < 15; i++)
    {
        adc_value = adc_read_once();
        sum += adc_value;

        if (adc_value < min_value) min_value = adc_value;
        if (adc_value > max_value) max_value = adc_value;

        delay_ms(20);
    }

    sum = sum - min_value - max_value;

    return (uint16_t)(sum / 13);
}

uint32_t calibrate_soil_moisture_x10(uint16_t adc_value)
{
    int32_t moisture_x10;
    int32_t dry_adc = (int32_t)SOIL_DRY_ADC;
    int32_t wet_adc = (int32_t)SOIL_WET_ADC;
    int32_t adc = (int32_t)adc_value;

    moisture_x10 = ((dry_adc - adc) * 1000) / (dry_adc - wet_adc);

    if (moisture_x10 < 0) moisture_x10 = 0;
    if (moisture_x10 > 1000) moisture_x10 = 1000;

    return (uint32_t)moisture_x10;
}

void soil_sequence_read(uint16_t *soil_raw_adc,
                        uint32_t *soil_moisture_x10)
{
    uint16_t raw_adc;
    uint32_t moisture_x10;

    soil_power_on();
    delay_ms(2000);

    raw_adc = read_soil_adc_filtered();
    moisture_x10 = calibrate_soil_moisture_x10(raw_adc);

    soil_power_off();

    *soil_raw_adc = raw_adc;
    *soil_moisture_x10 = moisture_x10;
}

/* ================= I2C ================= */

void i2c_release_pins(void)
{
    UCB0CTL1 |= UCSWRST;

    P1SEL  &= ~(I2C_SCL | I2C_SDA);
    P1SEL2 &= ~(I2C_SCL | I2C_SDA);

    P1DIR &= ~(I2C_SCL | I2C_SDA);
    P1REN &= ~(I2C_SCL | I2C_SDA);
}

void i2c_init(void)
{
    UCB0CTL1 |= UCSWRST;

    P1SEL  |= I2C_SCL | I2C_SDA;
    P1SEL2 |= I2C_SCL | I2C_SDA;

    UCB0CTL0 = UCMST | UCMODE_3 | UCSYNC;
    UCB0CTL1 = UCSSEL_2 | UCSWRST;

    UCB0BR0 = 10;
    UCB0BR1 = 0;

    UCB0STAT &= ~UCNACKIFG;

    UCB0CTL1 &= ~UCSWRST;
}

void i2c_bus_recover(void)
{
    uint8_t i;

    i2c_release_pins();

    P1DIR |= I2C_SCL;
    P1DIR &= ~I2C_SDA;

    for (i = 0; i < 9; i++)
    {
        P1OUT &= ~I2C_SCL;
        delay_ms(1);

        P1OUT |= I2C_SCL;
        delay_ms(1);
    }

    P1DIR &= ~(I2C_SCL | I2C_SDA);
}

uint8_t i2c_write(uint8_t address, uint8_t *data, uint8_t length)
{
    uint8_t i;
    uint16_t timeout;

    while (UCB0CTL1 & UCTXSTP);

    UCB0STAT &= ~UCNACKIFG;
    UCB0I2CSA = address;

    UCB0CTL1 |= UCTR | UCTXSTT;

    for (i = 0; i < length; i++)
    {
        timeout = I2C_TIMEOUT;

        while (!(IFG2 & UCB0TXIFG))
        {
            if (UCB0STAT & UCNACKIFG)
            {
                UCB0STAT &= ~UCNACKIFG;
                UCB0CTL1 |= UCTXSTP;
                return 0;
            }

            if (--timeout == 0)
            {
                UCB0CTL1 |= UCTXSTP;
                return 0;
            }
        }

        UCB0TXBUF = data[i];
    }

    timeout = I2C_TIMEOUT;

    while (!(IFG2 & UCB0TXIFG))
    {
        if (UCB0STAT & UCNACKIFG)
        {
            UCB0STAT &= ~UCNACKIFG;
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }

        if (--timeout == 0)
        {
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }
    }

    UCB0CTL1 |= UCTXSTP;

    timeout = I2C_TIMEOUT;
    while ((UCB0CTL1 & UCTXSTP) && timeout--);

    return 1;
}

uint8_t i2c_read(uint8_t address, uint8_t *data, uint8_t length)
{
    uint8_t i;
    uint16_t timeout;

    if (length == 0) return 0;

    while (UCB0CTL1 & UCTXSTP);

    UCB0STAT &= ~UCNACKIFG;
    UCB0I2CSA = address;

    UCB0CTL1 &= ~UCTR;
    UCB0CTL1 |= UCTXSTT;

    timeout = I2C_TIMEOUT;

    while (UCB0CTL1 & UCTXSTT)
    {
        if (UCB0STAT & UCNACKIFG)
        {
            UCB0STAT &= ~UCNACKIFG;
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }

        if (--timeout == 0)
        {
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }
    }

    for (i = 0; i < length; i++)
    {
        if (i == length - 1)
        {
            UCB0CTL1 |= UCTXSTP;
        }

        timeout = I2C_TIMEOUT;

        while (!(IFG2 & UCB0RXIFG))
        {
            if (--timeout == 0)
            {
                UCB0CTL1 |= UCTXSTP;
                return 0;
            }
        }

        data[i] = UCB0RXBUF;
    }

    timeout = I2C_TIMEOUT;
    while ((UCB0CTL1 & UCTXSTP) && timeout--);

    return 1;
}

/* ================= BH1750 ================= */

uint8_t bh1750_read_lux_x10(uint8_t address, uint32_t *lux_x10)
{
    uint8_t cmd = 0x20;
    uint8_t data[2];
    uint16_t raw;

    if (!i2c_write(address, &cmd, 1)) return 0;

    delay_ms(180);

    if (!i2c_read(address, data, 2)) return 0;

    raw = ((uint16_t)data[0] << 8) | data[1];

    *lux_x10 = ((uint32_t)raw * 100UL) / 12UL;

    return 1;
}

uint32_t trimmed_mean5_u32(uint32_t a,
                           uint32_t b,
                           uint32_t c,
                           uint32_t d,
                           uint32_t e)
{
    uint32_t arr[5];
    uint8_t i, j;
    uint32_t temp;

    arr[0] = a;
    arr[1] = b;
    arr[2] = c;
    arr[3] = d;
    arr[4] = e;

    for (i = 0; i < 4; i++)
    {
        for (j = i + 1; j < 5; j++)
        {
            if (arr[j] < arr[i])
            {
                temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }
    }

    return (arr[1] + arr[2] + arr[3]) / 3;
}

uint32_t calibrate_bh1750_lux_x10(uint32_t bh1750_lux_x10)
{
    int32_t x;
    int32_t y;

    const int32_t X1 = 8663;
    const int32_t Y1 = 6200;

    const int32_t X2 = 14649;
    const int32_t Y2 = 10700;

    const int32_t X3 = 39635;
    const int32_t Y3 = 29000;

    const int32_t X4 = 67785;
    const int32_t Y4 = 49000;

    const int32_t X5 = 79020;
    const int32_t Y5 = 60000;

    const int32_t X6 = 94873;
    const int32_t Y6 = 80000;

    x = (int32_t)bh1750_lux_x10;

    if (x <= X1)
        y = (int32_t)(((int64_t)x * Y1) / X1);
    else if (x <= X2)
        y = Y1 + (int32_t)(((int64_t)(x - X1) * (Y2 - Y1)) / (X2 - X1));
    else if (x <= X3)
        y = Y2 + (int32_t)(((int64_t)(x - X2) * (Y3 - Y2)) / (X3 - X2));
    else if (x <= X4)
        y = Y3 + (int32_t)(((int64_t)(x - X3) * (Y4 - Y3)) / (X4 - X3));
    else if (x <= X5)
        y = Y4 + (int32_t)(((int64_t)(x - X4) * (Y5 - Y4)) / (X5 - X4));
    else
        y = Y5 + (int32_t)(((int64_t)(x - X5) * (Y6 - Y5)) / (X6 - X5));

    if (y < 0) y = 0;

    return (uint32_t)y;
}

uint8_t bh1750_sequence_read(uint32_t *raw_lux_x10,
                             uint32_t *cal_lux_x10)
{
    uint8_t ok = 0;
    uint32_t dummy;
    uint32_t r1, r2, r3, r4, r5;
    uint32_t raw_filtered;

    bh1750_power_on();
    delay_ms(300);

    i2c_bus_recover();
    i2c_init();

    if (!bh1750_read_lux_x10(BH1750_ADDR_1, &dummy))
    {
        i2c_bus_recover();
        i2c_init();

        if (!bh1750_read_lux_x10(BH1750_ADDR_2, &dummy))
        {
            i2c_release_pins();
            bh1750_power_off();
            return 0;
        }
        else
        {
            ok = BH1750_ADDR_2;
        }
    }
    else
    {
        ok = BH1750_ADDR_1;
    }

    delay_ms(50);

    if (!bh1750_read_lux_x10(ok, &r1)) goto fail;
    delay_ms(50);
    if (!bh1750_read_lux_x10(ok, &r2)) goto fail;
    delay_ms(50);
    if (!bh1750_read_lux_x10(ok, &r3)) goto fail;
    delay_ms(50);
    if (!bh1750_read_lux_x10(ok, &r4)) goto fail;
    delay_ms(50);
    if (!bh1750_read_lux_x10(ok, &r5)) goto fail;

    raw_filtered = trimmed_mean5_u32(r1, r2, r3, r4, r5);

    *raw_lux_x10 = raw_filtered;
    *cal_lux_x10 = calibrate_bh1750_lux_x10(raw_filtered);

    i2c_release_pins();
    bh1750_power_off();

    return 1;

fail:
    i2c_release_pins();
    bh1750_power_off();
    return 0;
}

/* ================= SHT3X ================= */

uint8_t sht3x_crc8(uint8_t *data, uint8_t length)
{
    uint8_t crc = 0xFF;
    uint8_t i;
    uint8_t bit;

    for (i = 0; i < length; i++)
    {
        crc ^= data[i];

        for (bit = 0; bit < 8; bit++)
        {
            if (crc & 0x80)
                crc = (crc << 1) ^ 0x31;
            else
                crc <<= 1;
        }
    }

    return crc;
}

uint8_t sht3x_read_temp_humidity(uint8_t address,
                                 int32_t *temperature_x10,
                                 uint32_t *humidity_x10)
{
    uint8_t cmd[2];
    uint8_t data[6];

    uint16_t raw_temp;
    uint16_t raw_hum;

    cmd[0] = 0x24;
    cmd[1] = 0x00;

    if (!i2c_write(address, cmd, 2)) return 0;

    delay_ms(20);

    if (!i2c_read(address, data, 6)) return 0;

    if (sht3x_crc8(&data[0], 2) != data[2]) return 0;
    if (sht3x_crc8(&data[3], 2) != data[5]) return 0;

    raw_temp = ((uint16_t)data[0] << 8) | data[1];
    raw_hum  = ((uint16_t)data[3] << 8) | data[4];

    *temperature_x10 = -450 + (((int32_t)1750 * raw_temp) / 65535);
    *humidity_x10 = ((uint32_t)1000 * raw_hum) / 65535;

    return 1;
}

uint8_t sht3x_sequence_read(int32_t *air_temp_x10,
                            uint32_t *air_hum_x10)
{
    uint8_t ok = 0;

    sht3x_power_on();
    delay_ms(300);

    i2c_bus_recover();
    i2c_init();

    if (sht3x_read_temp_humidity(SHT3X_ADDR_1,
                                 air_temp_x10,
                                 air_hum_x10))
    {
        ok = 1;
    }
    else
    {
        i2c_bus_recover();
        i2c_init();

        if (sht3x_read_temp_humidity(SHT3X_ADDR_2,
                                     air_temp_x10,
                                     air_hum_x10))
        {
            ok = 1;
        }
    }

    i2c_release_pins();
    sht3x_power_off();

    return ok;
}

/* ================= DS18B20 ================= */

void ds18b20_release(void)
{
    P1DIR &= ~DS18B20_PIN;
}

void ds18b20_low(void)
{
    P1OUT &= ~DS18B20_PIN;
    P1DIR |= DS18B20_PIN;
}

void delay_us(uint16_t us)
{
    while (us--)
    {
        __delay_cycles(1);
    }
}

uint8_t ds18b20_reset(void)
{
    uint8_t presence;

    __disable_interrupt();

    ds18b20_low();
    delay_us(480);

    ds18b20_release();
    delay_us(70);

    presence = (P1IN & DS18B20_PIN) ? 0 : 1;

    delay_us(410);

    __enable_interrupt();

    return presence;
}

void ds18b20_write_bit(uint8_t bit_value)
{
    __disable_interrupt();

    ds18b20_low();

    if (bit_value)
    {
        delay_us(6);
        ds18b20_release();
        delay_us(64);
    }
    else
    {
        delay_us(60);
        ds18b20_release();
        delay_us(10);
    }

    __enable_interrupt();
}

uint8_t ds18b20_read_bit(void)
{
    uint8_t bit_value;

    __disable_interrupt();

    ds18b20_low();
    delay_us(6);

    ds18b20_release();
    delay_us(9);

    bit_value = (P1IN & DS18B20_PIN) ? 1 : 0;

    delay_us(55);

    __enable_interrupt();

    return bit_value;
}

void ds18b20_write_byte(uint8_t value)
{
    uint8_t i;

    for (i = 0; i < 8; i++)
    {
        ds18b20_write_bit(value & 0x01);
        value >>= 1;
    }
}

uint8_t ds18b20_read_byte(void)
{
    uint8_t i;
    uint8_t value = 0;

    for (i = 0; i < 8; i++)
    {
        if (ds18b20_read_bit())
        {
            value |= (1 << i);
        }
    }

    return value;
}

uint8_t ds18b20_read_temperature_x100(int32_t *temp_x100)
{
    uint8_t lsb;
    uint8_t msb;
    int16_t raw;

    if (!ds18b20_reset()) return 0;

    ds18b20_write_byte(0xCC);
    ds18b20_write_byte(0x44);

    delay_ms(750);

    if (!ds18b20_reset()) return 0;

    ds18b20_write_byte(0xCC);
    ds18b20_write_byte(0xBE);

    lsb = ds18b20_read_byte();
    msb = ds18b20_read_byte();

    raw = (int16_t)(((uint16_t)msb << 8) | lsb);

    *temp_x100 = ((int32_t)raw * 100) / 16;

    return 1;
}

/* ================= LPM3 SLEEP ================= */

void sleep_5_minutes_lpm3(void)
{
    sleep_counter = 0;

    BCSCTL3 |= LFXT1S_2;     // ACLK = VLO

    TA0CCTL0 = CCIE;
    TA0CCR0 = ACLK_FREQ_HZ - 1;

    TA0CTL = TASSEL_1 | MC_1 | TACLR;

    __bis_SR_register(LPM3_bits | GIE);

    TA0CTL = MC_0;
    TA0CCTL0 = 0;
}

#pragma vector = TIMER0_A0_VECTOR
__interrupt void Timer_A0_ISR(void)
{
    sleep_counter++;

    if (sleep_counter >= SLEEP_SECONDS)
    {
        __bic_SR_register_on_exit(LPM3_bits);
    }
}

/* ================= THRESHOLD CONTROL ================= */

void fan_threshold_control(uint8_t sht_ok,
                           int32_t air_temp_x10,
                           uint32_t air_hum_x10)
{
    if (!sht_ok)
    {
        fan_off();
        uart_puts("FAN COMMAND = OFF, SHT3X failed\r\n");
        return;
    }

    if (fan_state == 0)
    {
        if ((air_temp_x10 >= FAN_TEMP_ON_X10) ||
            (air_hum_x10 >= FAN_RH_ON_X10))
        {
            fan_on();
            uart_puts("FAN COMMAND = ON\r\n");
        }
        else
        {
            fan_off();
            uart_puts("FAN COMMAND = OFF\r\n");
        }
    }
    else
    {
        if ((air_temp_x10 <= FAN_TEMP_OFF_X10) &&
            (air_hum_x10 <= FAN_RH_OFF_X10))
        {
            fan_off();
            uart_puts("FAN COMMAND = OFF\r\n");
        }
        else
        {
            fan_on();
            uart_puts("FAN COMMAND = KEEP ON\r\n");
        }
    }
}

void humidifier_threshold_control(uint8_t sht_ok,
                                  uint32_t air_hum_x10)
{
    if (!sht_ok)
    {
        humidifier_off();
        uart_puts("HUMIDIFIER COMMAND = OFF, SHT3X failed\r\n");
        return;
    }

    if (humidifier_state == 0)
    {
        if (air_hum_x10 <= HUM_RH_ON_X10)
        {
            humidifier_on();
            uart_puts("HUMIDIFIER COMMAND = ON\r\n");
        }
        else
        {
            humidifier_off();
            uart_puts("HUMIDIFIER COMMAND = OFF\r\n");
        }
    }
    else
    {
        if (air_hum_x10 >= HUM_RH_OFF_X10)
        {
            humidifier_off();
            uart_puts("HUMIDIFIER COMMAND = OFF\r\n");
        }
        else
        {
            humidifier_on();
            uart_puts("HUMIDIFIER COMMAND = KEEP ON\r\n");
        }
    }
}

void solenoid_pulse_control(uint32_t soil_moisture_x10)
{
    if (irrigation_lockout_counter > 0)
    {
        irrigation_lockout_counter--;

        uart_puts("SOLENOID COMMAND = LOCKOUT, remaining cycles = ");
        uart_print_uint32(irrigation_lockout_counter);
        uart_puts("\r\n");
        return;
    }

    if (soil_moisture_x10 < SOIL_LOW_X10)
    {
        uart_puts("SOLENOID COMMAND = ON for 5 seconds\r\n");

        solenoid_on();
        delay_ms(SOLENOID_PULSE_MS);
        solenoid_off();

        uart_puts("SOLENOID COMMAND = OFF after pulse\r\n");

        irrigation_lockout_counter = IRRIGATION_LOCKOUT_CYCLES;
    }
    else if (soil_moisture_x10 > SOIL_HIGH_X10)
    {
        solenoid_off();
        uart_puts("SOLENOID COMMAND = OFF, soil too wet\r\n");
    }
    else
    {
        solenoid_off();
        uart_puts("SOLENOID COMMAND = OFF, soil moisture OK\r\n");
    }
}

void peltier_threshold_control(uint8_t sht_ok,
                               int32_t air_temp_x10,
                               uint8_t ds_ok,
                               int32_t soil_temp_x100)
{
    uint8_t cooling_needed = 0;
    uint8_t cooling_safe = 0;

    if (sht_ok && (air_temp_x10 >= PELTIER_AIR_ON_X10))
    {
        cooling_needed = 1;
    }

    if (ds_ok && (soil_temp_x100 >= PELTIER_SOIL_ON_X100))
    {
        cooling_needed = 1;
    }

    cooling_safe = 1;

    if (sht_ok && (air_temp_x10 > PELTIER_AIR_OFF_X10))
    {
        cooling_safe = 0;
    }

    if (ds_ok && (soil_temp_x100 > PELTIER_SOIL_OFF_X100))
    {
        cooling_safe = 0;
    }

    if (!sht_ok && !ds_ok)
    {
        cooling_safe = 1;
        cooling_needed = 0;
    }

    if (peltier_state == 0)
    {
        if (cooling_needed)
        {
            uart_puts("PELTIER SEQUENCE: Pump ON first\r\n");

            pump_on();
            delay_ms(PUMP_PRE_RUN_MS);

            uart_puts("PELTIER COMMAND = ON\r\n");
            peltier_on();
        }
        else
        {
            peltier_off();

            if (pump_state)
            {
                pump_off();
            }

            uart_puts("PELTIER COMMAND = OFF\r\n");
        }
    }
    else
    {
        if (cooling_safe)
        {
            uart_puts("PELTIER COMMAND = OFF\r\n");
            peltier_off();

            uart_puts("Pump after-run 30 seconds\r\n");
            pump_on();
            delay_ms(PUMP_AFTER_RUN_MS);

            pump_off();
            uart_puts("PUMP COMMAND = OFF\r\n");
        }
        else
        {
            pump_on();
            peltier_on();
            uart_puts("PELTIER COMMAND = KEEP ON, PUMP KEEP ON\r\n");
        }
    }
}

/* ================= MAIN ================= */

int main(void)
{
    uint16_t soil_raw_adc;
    uint32_t soil_moisture_x10;

    uint32_t light_raw_x10;
    uint32_t light_cal_x10;
    uint8_t bh_ok;

    int32_t air_temp_x10 = 0;
    uint32_t air_hum_x10 = 0;
    uint8_t sht_ok;

    int32_t soil_temp_x100 = 0;
    uint8_t ds_ok;

    WDTCTL = WDTPW | WDTHOLD;

    clock_init();
    uart_init();

    sensor_power_init();
    shift_register_init();

    shift_register_state = 0x00;
    shift_register_write(shift_register_state);
    shift_register_enable_outputs();

    all_actuators_off();
    all_sensors_off();
    i2c_release_pins();

    uart_puts("\r\n====================================\r\n");
    uart_puts("FINAL SAFFRON CONTROL NODE STARTED\r\n");
    uart_puts("Sensors: Soil, BH1750, SHT3X, DS18B20\r\n");
    uart_puts("Actuators: Fan, Solenoid, Humidifier, Peltier, Pump\r\n");
    uart_puts("Sleep: LPM3 for 5 minutes after each cycle\r\n");
    uart_puts("====================================\r\n");

    while (1)
    {
        uart_puts("\r\n============== NEW 5-MIN CYCLE ==============\r\n");

        adc_init();

        /* ---------- 1. SOIL SENSOR ---------- */

        uart_puts("\r\n[1] Soil moisture sensor reading\r\n");

        soil_sequence_read(&soil_raw_adc, &soil_moisture_x10);

        uart_puts("Soil raw ADC = ");
        uart_print_uint32(soil_raw_adc);
        uart_puts("\r\n");

        uart_puts("Soil moisture = ");
        uart_print_uint_x10(soil_moisture_x10);
        uart_puts(" %\r\n");

        /* ---------- 2. BH1750 ---------- */

        uart_puts("\r\n[2] BH1750 light sensor reading\r\n");

        bh_ok = bh1750_sequence_read(&light_raw_x10, &light_cal_x10);

        if (bh_ok)
        {
            uart_puts("BH1750 raw lux = ");
            uart_print_uint_x10(light_raw_x10);
            uart_puts(" lx\r\n");

            uart_puts("BH1750 calibrated lux = ");
            uart_print_uint_x10(light_cal_x10);
            uart_puts(" lx\r\n");
        }
        else
        {
            light_raw_x10 = 0;
            light_cal_x10 = 0;
            uart_puts("BH1750 read failed\r\n");
        }

        /* ---------- 3. SHT3X ---------- */

        uart_puts("\r\n[3] SHT3X air temperature/humidity reading\r\n");

        sht_ok = sht3x_sequence_read(&air_temp_x10, &air_hum_x10);

        if (sht_ok)
        {
            uart_puts("Air temperature = ");
            uart_print_int_x10(air_temp_x10);
            uart_puts(" C\r\n");

            uart_puts("Humidity = ");
            uart_print_uint_x10(air_hum_x10);
            uart_puts(" %RH\r\n");
        }
        else
        {
            uart_puts("SHT3X read failed\r\n");
        }

        /* ---------- 4. DS18B20 ---------- */

        uart_puts("\r\n[4] DS18B20 soil/corm temperature reading\r\n");

        ds_ok = ds18b20_read_temperature_x100(&soil_temp_x100);

        if (ds_ok)
        {
            uart_puts("Soil/corm temperature = ");
            uart_print_int_x100(soil_temp_x100);
            uart_puts(" C\r\n");
        }
        else
        {
            uart_puts("DS18B20 read failed\r\n");
        }

        /* ---------- ACTUATOR DECISIONS ---------- */

        uart_puts("\r\n---------- ACTUATOR DECISION ----------\r\n");

        fan_threshold_control(sht_ok, air_temp_x10, air_hum_x10);
        humidifier_threshold_control(sht_ok, air_hum_x10);
        solenoid_pulse_control(soil_moisture_x10);
        peltier_threshold_control(sht_ok, air_temp_x10, ds_ok, soil_temp_x100);

        uart_puts("\r\n---------- ACTUATOR STATES ----------\r\n");

        uart_puts("Fan = ");
        uart_puts(fan_state ? "ON\r\n" : "OFF\r\n");

        uart_puts("Solenoid = ");
        uart_puts(solenoid_state ? "ON\r\n" : "OFF\r\n");

        uart_puts("Humidifier = ");
        uart_puts(humidifier_state ? "ON\r\n" : "OFF\r\n");

        uart_puts("Peltier = ");
        uart_puts(peltier_state ? "ON\r\n" : "OFF\r\n");

        uart_puts("Pump = ");
        uart_puts(pump_state ? "ON\r\n" : "OFF\r\n");

        uart_puts("-------------------------------------\r\n");

        /* ---------- PREPARE FOR SLEEP ---------- */

        all_sensors_off();
        i2c_release_pins();
        adc_disable();
        ds18b20_release();

        uart_puts("\r\nGoing to LPM3 sleep for 5 minutes...\r\n");
        delay_ms(50);

        sleep_5_minutes_lpm3();

        uart_puts("\r\nWake up from LPM3\r\n");
    }
}
