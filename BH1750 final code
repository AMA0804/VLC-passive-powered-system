#include <msp430.h>
#include <stdint.h>

/* ================= PIN DEFINITIONS ================= */

#define BH1750_MOSFET      BIT4    // P1.4 -> BSS138 gate

#define I2C_SCL            BIT6    // P1.6
#define I2C_SDA            BIT7    // P1.7

#define BH1750_ADDR_1      0x23
#define BH1750_ADDR_2      0x5C

#define I2C_TIMEOUT        60000

/* ================= EMA FILTER ================= */
/*
   alpha = 0.2
   alpha = 2 / 10
*/

#define EMA_ALPHA_NUM      2
#define EMA_ALPHA_DEN      10

/* ================= DELAY ================= */

void delay_ms(uint16_t ms)
{
    while (ms--)
    {
        __delay_cycles(1000);   // 1 MHz clock
    }
}

/* ================= CLOCK ================= */

void clock_init(void)
{
    if (CALBC1_1MHZ != 0xFF)
    {
        DCOCTL = 0;
        BCSCTL1 = CALBC1_1MHZ;
        DCOCTL = CALDCO_1MHZ;
    }
}

/* ================= UART ================= */

void uart_init(void)
{
    P1SEL  |= BIT1 | BIT2;
    P1SEL2 |= BIT1 | BIT2;

    UCA0CTL1 |= UCSWRST;
    UCA0CTL1 |= UCSSEL_2;      // SMCLK

    UCA0BR0 = 104;             // 9600 baud at 1 MHz
    UCA0BR1 = 0;
    UCA0MCTL = UCBRS0;

    UCA0CTL1 &= ~UCSWRST;
}

void uart_putc(char c)
{
    while (!(IFG2 & UCA0TXIFG));
    UCA0TXBUF = c;
}

void uart_puts(const char *s)
{
    while (*s)
    {
        uart_putc(*s++);
    }
}

void uart_print_uint32(uint32_t value)
{
    char buffer[11];
    uint8_t i = 0;

    if (value == 0)
    {
        uart_putc('0');
        return;
    }

    while (value > 0)
    {
        buffer[i++] = (value % 10) + '0';
        value /= 10;
    }

    while (i > 0)
    {
        uart_putc(buffer[--i]);
    }
}

void uart_print_lux_x10(uint32_t lux_x10)
{
    uart_print_uint32(lux_x10 / 10);
    uart_putc('.');
    uart_print_uint32(lux_x10 % 10);
}

/* ================= BH1750 POWER CONTROL ================= */

void bh1750_power_init(void)
{
    P1SEL  &= ~BH1750_MOSFET;
    P1SEL2 &= ~BH1750_MOSFET;

    P1OUT &= ~BH1750_MOSFET;    // MOSFET OFF first
    P1DIR |= BH1750_MOSFET;     // P1.4 output
}

void bh1750_power_on(void)
{
    P1OUT |= BH1750_MOSFET;     // Gate HIGH -> BSS138 ON
}

void bh1750_power_off(void)
{
    P1OUT &= ~BH1750_MOSFET;    // Gate LOW -> BSS138 OFF
}

/* ================= I2C ================= */

void i2c_release_pins(void)
{
    UCB0CTL1 |= UCSWRST;

    P1SEL  &= ~(I2C_SCL | I2C_SDA);
    P1SEL2 &= ~(I2C_SCL | I2C_SDA);

    P1DIR &= ~(I2C_SCL | I2C_SDA);

    P1REN &= ~(I2C_SCL | I2C_SDA);
}

void i2c_init(void)
{
    UCB0CTL1 |= UCSWRST;

    P1SEL  |= I2C_SCL | I2C_SDA;
    P1SEL2 |= I2C_SCL | I2C_SDA;

    UCB0CTL0 = UCMST | UCMODE_3 | UCSYNC;   // I2C master
    UCB0CTL1 = UCSSEL_2 | UCSWRST;          // SMCLK

    UCB0BR0 = 10;                           // 100 kHz I2C at 1 MHz
    UCB0BR1 = 0;

    UCB0STAT &= ~UCNACKIFG;

    UCB0CTL1 &= ~UCSWRST;
}

void i2c_bus_recover(void)
{
    uint8_t i;

    i2c_release_pins();

    P1DIR |= I2C_SCL;
    P1DIR &= ~I2C_SDA;

    for (i = 0; i < 9; i++)
    {
        P1OUT &= ~I2C_SCL;
        delay_ms(1);

        P1OUT |= I2C_SCL;
        delay_ms(1);
    }

    P1DIR &= ~(I2C_SCL | I2C_SDA);
}

uint8_t i2c_write(uint8_t address, uint8_t *data, uint8_t length)
{
    uint8_t i;
    uint16_t timeout;

    while (UCB0CTL1 & UCTXSTP);

    UCB0STAT &= ~UCNACKIFG;
    UCB0I2CSA = address;

    UCB0CTL1 |= UCTR | UCTXSTT;

    for (i = 0; i < length; i++)
    {
        timeout = I2C_TIMEOUT;

        while (!(IFG2 & UCB0TXIFG))
        {
            if (UCB0STAT & UCNACKIFG)
            {
                UCB0STAT &= ~UCNACKIFG;
                UCB0CTL1 |= UCTXSTP;
                return 0;
            }

            if (--timeout == 0)
            {
                UCB0CTL1 |= UCTXSTP;
                return 0;
            }
        }

        UCB0TXBUF = data[i];
    }

    timeout = I2C_TIMEOUT;

    while (!(IFG2 & UCB0TXIFG))
    {
        if (UCB0STAT & UCNACKIFG)
        {
            UCB0STAT &= ~UCNACKIFG;
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }

        if (--timeout == 0)
        {
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }
    }

    UCB0CTL1 |= UCTXSTP;

    timeout = I2C_TIMEOUT;
    while ((UCB0CTL1 & UCTXSTP) && timeout--);

    return 1;
}

uint8_t i2c_read(uint8_t address, uint8_t *data, uint8_t length)
{
    uint8_t i;
    uint16_t timeout;

    if (length == 0)
    {
        return 0;
    }

    while (UCB0CTL1 & UCTXSTP);

    UCB0STAT &= ~UCNACKIFG;
    UCB0I2CSA = address;

    UCB0CTL1 &= ~UCTR;
    UCB0CTL1 |= UCTXSTT;

    timeout = I2C_TIMEOUT;

    while (UCB0CTL1 & UCTXSTT)
    {
        if (UCB0STAT & UCNACKIFG)
        {
            UCB0STAT &= ~UCNACKIFG;
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }

        if (--timeout == 0)
        {
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }
    }

    for (i = 0; i < length; i++)
    {
        if (i == length - 1)
        {
            UCB0CTL1 |= UCTXSTP;
        }

        timeout = I2C_TIMEOUT;

        while (!(IFG2 & UCB0RXIFG))
        {
            if (--timeout == 0)
            {
                UCB0CTL1 |= UCTXSTP;
                return 0;
            }
        }

        data[i] = UCB0RXBUF;
    }

    timeout = I2C_TIMEOUT;
    while ((UCB0CTL1 & UCTXSTP) && timeout--);

    return 1;
}

/* ================= BASIC BH1750 READ ================= */

uint8_t bh1750_read_lux_x10(uint8_t address, uint32_t *lux_x10)
{
    uint8_t cmd;
    uint8_t data[2];
    uint16_t raw;

    cmd = 0x20;   // One-time high resolution mode

    if (!i2c_write(address, &cmd, 1))
    {
        return 0;
    }

    delay_ms(180);

    if (!i2c_read(address, data, 2))
    {
        return 0;
    }

    raw = ((uint16_t)data[0] << 8) | data[1];

    /*
       BH1750 equation:
       lux = raw / 1.2

       lux_x10 = lux * 10
       lux_x10 = raw * 100 / 12
    */

    *lux_x10 = ((uint32_t)raw * 100UL) / 12UL;

    return 1;
}

/* ================= TRIMMED MEAN FILTER ================= */

uint32_t trimmed_mean5(uint32_t a,
                       uint32_t b,
                       uint32_t c,
                       uint32_t d,
                       uint32_t e)
{
    uint32_t arr[5];
    uint8_t i, j;
    uint32_t temp;

    arr[0] = a;
    arr[1] = b;
    arr[2] = c;
    arr[3] = d;
    arr[4] = e;

    for (i = 0; i < 4; i++)
    {
        for (j = i + 1; j < 5; j++)
        {
            if (arr[j] < arr[i])
            {
                temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }
    }

    // Remove lowest and highest, average middle 3
    return (arr[1] + arr[2] + arr[3]) / 3;
}

/* ================= PIECEWISE CALIBRATION ================= */

uint32_t calibrate_bh1750_lux_x10(uint32_t bh1750_lux_x10)
{
    int32_t x;
    int32_t y;

    /*
       Calibration points in lux_x10.

       100 cm, 25%:
       BH1750 = 866.3 lx, Lux meter = 620 lx

       100 cm, 50%:
       BH1750 = 1464.9 lx, Lux meter = 1070 lx

       50 cm, 25%:
       BH1750 = 3963.5 lx, Lux meter = 2900 lx

       50 cm, 50%:
       BH1750 = 6778.5 lx, Lux meter = 4900 lx

       50 cm, 75%:
       BH1750 = 7902.0 lx, Lux meter = 6000 lx

       50 cm, 100%:
       BH1750 = 9487.3 lx, Lux meter = 8000 lx
    */

    const int32_t X1 = 8663;
    const int32_t Y1 = 6200;

    const int32_t X2 = 14649;
    const int32_t Y2 = 10700;

    const int32_t X3 = 39635;
    const int32_t Y3 = 29000;

    const int32_t X4 = 67785;
    const int32_t Y4 = 49000;

    const int32_t X5 = 79020;
    const int32_t Y5 = 60000;

    const int32_t X6 = 94873;
    const int32_t Y6 = 80000;

    x = (int32_t)bh1750_lux_x10;

    if (x <= X1)
    {
        // 0 lux to first calibration point
        y = (int32_t)(((int64_t)x * Y1) / X1);
    }
    else if (x <= X2)
    {
        // 100 cm, 25% to 100 cm, 50%
        y = Y1 + (int32_t)(((int64_t)(x - X1) * (Y2 - Y1)) / (X2 - X1));
    }
    else if (x <= X3)
    {
        // 100 cm, 50% to 50 cm, 25%
        y = Y2 + (int32_t)(((int64_t)(x - X2) * (Y3 - Y2)) / (X3 - X2));
    }
    else if (x <= X4)
    {
        // 50 cm, 25% to 50 cm, 50%
        y = Y3 + (int32_t)(((int64_t)(x - X3) * (Y4 - Y3)) / (X4 - X3));
    }
    else if (x <= X5)
    {
        // 50 cm, 50% to 50 cm, 75%
        y = Y4 + (int32_t)(((int64_t)(x - X4) * (Y5 - Y4)) / (X5 - X4));
    }
    else
    {
        // 50 cm, 75% to 50 cm, 100%
        y = Y5 + (int32_t)(((int64_t)(x - X5) * (Y6 - Y5)) / (X6 - X5));
    }

    if (y < 0)
    {
        y = 0;
    }

    return (uint32_t)y;
}

/* ================= EMA FILTER ================= */

uint32_t ema_filter_lux_x10(uint32_t new_lux_x10)
{
    static uint8_t first_run = 1;
    static int32_t filtered_lux_x10 = 0;
    int32_t error;

    if (first_run)
    {
        filtered_lux_x10 = (int32_t)new_lux_x10;
        first_run = 0;
    }
    else
    {
        error = (int32_t)new_lux_x10 - filtered_lux_x10;

        filtered_lux_x10 = filtered_lux_x10 +
                           ((EMA_ALPHA_NUM * error) / EMA_ALPHA_DEN);
    }

    if (filtered_lux_x10 < 0)
    {
        filtered_lux_x10 = 0;
    }

    return (uint32_t)filtered_lux_x10;
}

/* ================= FINAL BH1750 READ FUNCTION ================= */

uint8_t bh1750_read_final(uint8_t address,
                          uint32_t *raw_filtered_lux_x10,
                          uint32_t *calibrated_lux_x10,
                          uint32_t *final_lux_x10)
{
    uint32_t dummy;
    uint32_t r1, r2, r3, r4, r5;
    uint32_t raw_filtered;
    uint32_t calibrated;

    // First reading after power ON is discarded
    if (!bh1750_read_lux_x10(address, &dummy))
    {
        return 0;
    }

    delay_ms(50);

    if (!bh1750_read_lux_x10(address, &r1)) return 0;
    delay_ms(50);

    if (!bh1750_read_lux_x10(address, &r2)) return 0;
    delay_ms(50);

    if (!bh1750_read_lux_x10(address, &r3)) return 0;
    delay_ms(50);

    if (!bh1750_read_lux_x10(address, &r4)) return 0;
    delay_ms(50);

    if (!bh1750_read_lux_x10(address, &r5)) return 0;

    raw_filtered = trimmed_mean5(r1, r2, r3, r4, r5);

    calibrated = calibrate_bh1750_lux_x10(raw_filtered);

    *raw_filtered_lux_x10 = raw_filtered;
    *calibrated_lux_x10 = calibrated;
    *final_lux_x10 = ema_filter_lux_x10(calibrated);

    return 1;
}

/* ================= MAIN ================= */

int main(void)
{
    uint32_t raw_lux_x10;
    uint32_t calibrated_lux_x10;
    uint32_t final_lux_x10;

    WDTCTL = WDTPW | WDTHOLD;

    clock_init();
    uart_init();

    bh1750_power_init();
    i2c_release_pins();

    uart_puts("\r\nBH1750 Final Reading Code Started\r\n");
    uart_puts("MOSFET Gate = P1.4\r\n");
    uart_puts("SCL = P1.6, SDA = P1.7\r\n");
    uart_puts("Filter = Trimmed mean + EMA\r\n");
    uart_puts("Calibration = Piecewise lux-meter calibration\r\n");

    while (1)
    {
        uart_puts("\r\n-----------------------------\r\n");

        /* ---------- SENSOR OFF ---------- */

        i2c_release_pins();
        bh1750_power_off();

        uart_puts("BH1750 OFF\r\n");
        delay_ms(1000);

        /* ---------- SENSOR ON ---------- */

        uart_puts("BH1750 ON\r\n");

        bh1750_power_on();

        // Wait for sensor power stabilization
        delay_ms(300);

        // Recover and initialize I2C after sensor power ON
        i2c_bus_recover();
        i2c_init();

        if (bh1750_read_final(BH1750_ADDR_1,
                              &raw_lux_x10,
                              &calibrated_lux_x10,
                              &final_lux_x10))
        {
            uart_puts("BH1750 address: 0x23\r\n");

            uart_puts("Raw filtered BH1750 lux = ");
            uart_print_lux_x10(raw_lux_x10);
            uart_puts(" lx\r\n");

            uart_puts("Calibrated lux = ");
            uart_print_lux_x10(calibrated_lux_x10);
            uart_puts(" lx\r\n");

            uart_puts("Final sensor lux = ");
            uart_print_lux_x10(final_lux_x10);
            uart_puts(" lx\r\n");
        }
        else if (bh1750_read_final(BH1750_ADDR_2,
                                   &raw_lux_x10,
                                   &calibrated_lux_x10,
                                   &final_lux_x10))
        {
            uart_puts("BH1750 address: 0x5C\r\n");

            uart_puts("Raw filtered BH1750 lux = ");
            uart_print_lux_x10(raw_lux_x10);
            uart_puts(" lx\r\n");

            uart_puts("Calibrated lux = ");
            uart_print_lux_x10(calibrated_lux_x10);
            uart_puts(" lx\r\n");

            uart_puts("Final sensor lux = ");
            uart_print_lux_x10(final_lux_x10);
            uart_puts(" lx\r\n");
        }
        else
        {
            uart_puts("BH1750 read failed\r\n");
        }

        /* ---------- SENSOR OFF AFTER READING ---------- */

        i2c_release_pins();
        bh1750_power_off();

        uart_puts("BH1750 OFF after reading\r\n");

        delay_ms(3000);
    }
}
