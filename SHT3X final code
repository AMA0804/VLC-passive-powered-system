#include <msp430.h>
#include <stdint.h>

/* ================= PIN DEFINITIONS ================= */

#define SHT3X_MOSFET   BIT4    // P1.4 -> BSS138 gate

#define I2C_SCL        BIT6    // P1.6
#define I2C_SDA        BIT7    // P1.7

#define SHT3X_ADDR_1   0x44
#define SHT3X_ADDR_2   0x45

#define I2C_TIMEOUT    60000

/* ================= FILTER SETTINGS ================= */
/*
   EMA alpha = 0.2
   final = old + 0.2 * (new - old)
*/

#define EMA_ALPHA_NUM  2
#define EMA_ALPHA_DEN  10

/* ================= DELAY ================= */

void delay_ms(uint16_t ms)
{
    while (ms--)
    {
        __delay_cycles(1000);   // 1 MHz clock
    }
}

/* ================= CLOCK ================= */

void clock_init(void)
{
    if (CALBC1_1MHZ != 0xFF)
    {
        DCOCTL = 0;
        BCSCTL1 = CALBC1_1MHZ;
        DCOCTL = CALDCO_1MHZ;
    }
}

/* ================= UART ================= */

void uart_init(void)
{
    P1SEL  |= BIT1 | BIT2;
    P1SEL2 |= BIT1 | BIT2;

    UCA0CTL1 |= UCSWRST;
    UCA0CTL1 |= UCSSEL_2;      // SMCLK

    UCA0BR0 = 104;             // 9600 baud at 1 MHz
    UCA0BR1 = 0;
    UCA0MCTL = UCBRS0;

    UCA0CTL1 &= ~UCSWRST;
}

void uart_putc(char c)
{
    while (!(IFG2 & UCA0TXIFG));
    UCA0TXBUF = c;
}

void uart_puts(const char *s)
{
    while (*s)
    {
        uart_putc(*s++);
    }
}

void uart_print_uint32(uint32_t value)
{
    char buffer[11];
    uint8_t i = 0;

    if (value == 0)
    {
        uart_putc('0');
        return;
    }

    while (value > 0)
    {
        buffer[i++] = (value % 10) + '0';
        value /= 10;
    }

    while (i > 0)
    {
        uart_putc(buffer[--i]);
    }
}

void uart_print_int_x10(int32_t value_x10)
{
    if (value_x10 < 0)
    {
        uart_putc('-');
        value_x10 = -value_x10;
    }

    uart_print_uint32((uint32_t)(value_x10 / 10));
    uart_putc('.');
    uart_print_uint32((uint32_t)(value_x10 % 10));
}

void uart_print_uint_x10(uint32_t value_x10)
{
    uart_print_uint32(value_x10 / 10);
    uart_putc('.');
    uart_print_uint32(value_x10 % 10);
}

/* ================= SHT3X MOSFET POWER CONTROL ================= */

void sht3x_power_init(void)
{
    P1SEL  &= ~SHT3X_MOSFET;
    P1SEL2 &= ~SHT3X_MOSFET;

    P1OUT &= ~SHT3X_MOSFET;    // MOSFET OFF first
    P1DIR |= SHT3X_MOSFET;     // P1.4 output
}

void sht3x_power_on(void)
{
    P1OUT |= SHT3X_MOSFET;     // Gate HIGH -> BSS138 ON
}

void sht3x_power_off(void)
{
    P1OUT &= ~SHT3X_MOSFET;    // Gate LOW -> BSS138 OFF
}

/* ================= I2C ================= */

void i2c_release_pins(void)
{
    UCB0CTL1 |= UCSWRST;

    P1SEL  &= ~(I2C_SCL | I2C_SDA);
    P1SEL2 &= ~(I2C_SCL | I2C_SDA);

    P1DIR &= ~(I2C_SCL | I2C_SDA);

    P1REN &= ~(I2C_SCL | I2C_SDA);
}

void i2c_init(void)
{
    UCB0CTL1 |= UCSWRST;

    P1SEL  |= I2C_SCL | I2C_SDA;
    P1SEL2 |= I2C_SCL | I2C_SDA;

    UCB0CTL0 = UCMST | UCMODE_3 | UCSYNC;   // I2C master
    UCB0CTL1 = UCSSEL_2 | UCSWRST;          // SMCLK

    UCB0BR0 = 10;                           // 100 kHz I2C at 1 MHz
    UCB0BR1 = 0;

    UCB0STAT &= ~UCNACKIFG;

    UCB0CTL1 &= ~UCSWRST;
}

void i2c_bus_recover(void)
{
    uint8_t i;

    i2c_release_pins();

    P1DIR |= I2C_SCL;
    P1DIR &= ~I2C_SDA;

    for (i = 0; i < 9; i++)
    {
        P1OUT &= ~I2C_SCL;
        delay_ms(1);

        P1OUT |= I2C_SCL;
        delay_ms(1);
    }

    P1DIR &= ~(I2C_SCL | I2C_SDA);
}

uint8_t i2c_write(uint8_t address, uint8_t *data, uint8_t length)
{
    uint8_t i;
    uint16_t timeout;

    while (UCB0CTL1 & UCTXSTP);

    UCB0STAT &= ~UCNACKIFG;
    UCB0I2CSA = address;

    UCB0CTL1 |= UCTR | UCTXSTT;

    for (i = 0; i < length; i++)
    {
        timeout = I2C_TIMEOUT;

        while (!(IFG2 & UCB0TXIFG))
        {
            if (UCB0STAT & UCNACKIFG)
            {
                UCB0STAT &= ~UCNACKIFG;
                UCB0CTL1 |= UCTXSTP;
                return 0;
            }

            if (--timeout == 0)
            {
                UCB0CTL1 |= UCTXSTP;
                return 0;
            }
        }

        UCB0TXBUF = data[i];
    }

    timeout = I2C_TIMEOUT;

    while (!(IFG2 & UCB0TXIFG))
    {
        if (UCB0STAT & UCNACKIFG)
        {
            UCB0STAT &= ~UCNACKIFG;
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }

        if (--timeout == 0)
        {
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }
    }

    UCB0CTL1 |= UCTXSTP;

    timeout = I2C_TIMEOUT;
    while ((UCB0CTL1 & UCTXSTP) && timeout--);

    return 1;
}

uint8_t i2c_read(uint8_t address, uint8_t *data, uint8_t length)
{
    uint8_t i;
    uint16_t timeout;

    if (length == 0)
    {
        return 0;
    }

    while (UCB0CTL1 & UCTXSTP);

    UCB0STAT &= ~UCNACKIFG;
    UCB0I2CSA = address;

    UCB0CTL1 &= ~UCTR;       // Receiver mode
    UCB0CTL1 |= UCTXSTT;     // START

    timeout = I2C_TIMEOUT;

    while (UCB0CTL1 & UCTXSTT)
    {
        if (UCB0STAT & UCNACKIFG)
        {
            UCB0STAT &= ~UCNACKIFG;
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }

        if (--timeout == 0)
        {
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }
    }

    for (i = 0; i < length; i++)
    {
        if (i == length - 1)
        {
            UCB0CTL1 |= UCTXSTP;
        }

        timeout = I2C_TIMEOUT;

        while (!(IFG2 & UCB0RXIFG))
        {
            if (--timeout == 0)
            {
                UCB0CTL1 |= UCTXSTP;
                return 0;
            }
        }

        data[i] = UCB0RXBUF;
    }

    timeout = I2C_TIMEOUT;
    while ((UCB0CTL1 & UCTXSTP) && timeout--);

    return 1;
}

/* ================= SHT3X CRC ================= */

uint8_t sht3x_crc8(uint8_t *data, uint8_t length)
{
    uint8_t crc = 0xFF;
    uint8_t i;
    uint8_t bit;

    for (i = 0; i < length; i++)
    {
        crc ^= data[i];

        for (bit = 0; bit < 8; bit++)
        {
            if (crc & 0x80)
            {
                crc = (crc << 1) ^ 0x31;
            }
            else
            {
                crc <<= 1;
            }
        }
    }

    return crc;
}

/* ================= BASIC SHT3X READ ================= */

uint8_t sht3x_read_temp_humidity(uint8_t address,
                                 int32_t *temperature_c_x10,
                                 uint32_t *humidity_x10)
{
    uint8_t cmd[2];
    uint8_t data[6];

    uint16_t raw_temp;
    uint16_t raw_hum;

    /*
       0x24 0x00:
       Single-shot measurement
       High repeatability
       Clock stretching disabled
    */

    cmd[0] = 0x24;
    cmd[1] = 0x00;

    if (!i2c_write(address, cmd, 2))
    {
        return 0;
    }

    delay_ms(20);

    if (!i2c_read(address, data, 6))
    {
        return 0;
    }

    if (sht3x_crc8(&data[0], 2) != data[2])
    {
        return 0;
    }

    if (sht3x_crc8(&data[3], 2) != data[5])
    {
        return 0;
    }

    raw_temp = ((uint16_t)data[0] << 8) | data[1];
    raw_hum  = ((uint16_t)data[3] << 8) | data[4];

    /*
       Temperature:
       T = -45 + 175 * raw / 65535

       T_x10 = -450 + 1750 * raw / 65535
    */

    *temperature_c_x10 = -450 + (((int32_t)1750 * raw_temp) / 65535);

    /*
       Humidity:
       RH = 100 * raw / 65535

       RH_x10 = 1000 * raw / 65535
    */

    *humidity_x10 = ((uint32_t)1000 * raw_hum) / 65535;

    return 1;
}

/* ================= TRIMMED MEAN FILTERS ================= */

int32_t trimmed_mean5_int(int32_t a,
                          int32_t b,
                          int32_t c,
                          int32_t d,
                          int32_t e)
{
    int32_t arr[5];
    int32_t temp;
    uint8_t i, j;

    arr[0] = a;
    arr[1] = b;
    arr[2] = c;
    arr[3] = d;
    arr[4] = e;

    for (i = 0; i < 4; i++)
    {
        for (j = i + 1; j < 5; j++)
        {
            if (arr[j] < arr[i])
            {
                temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }
    }

    // Remove lowest and highest, average middle 3
    return (arr[1] + arr[2] + arr[3]) / 3;
}

uint32_t trimmed_mean5_uint(uint32_t a,
                            uint32_t b,
                            uint32_t c,
                            uint32_t d,
                            uint32_t e)
{
    uint32_t arr[5];
    uint32_t temp;
    uint8_t i, j;

    arr[0] = a;
    arr[1] = b;
    arr[2] = c;
    arr[3] = d;
    arr[4] = e;

    for (i = 0; i < 4; i++)
    {
        for (j = i + 1; j < 5; j++)
        {
            if (arr[j] < arr[i])
            {
                temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }
    }

    // Remove lowest and highest, average middle 3
    return (arr[1] + arr[2] + arr[3]) / 3;
}

/* ================= EMA FILTERS ================= */

int32_t ema_filter_temperature_x10(int32_t new_temp_x10)
{
    static uint8_t first_run = 1;
    static int32_t filtered_temp_x10 = 0;
    int32_t error;

    if (first_run)
    {
        filtered_temp_x10 = new_temp_x10;
        first_run = 0;
    }
    else
    {
        error = new_temp_x10 - filtered_temp_x10;

        filtered_temp_x10 = filtered_temp_x10 +
                            ((EMA_ALPHA_NUM * error) / EMA_ALPHA_DEN);
    }

    return filtered_temp_x10;
}

uint32_t ema_filter_humidity_x10(uint32_t new_hum_x10)
{
    static uint8_t first_run = 1;
    static int32_t filtered_hum_x10 = 0;
    int32_t error;

    if (first_run)
    {
        filtered_hum_x10 = (int32_t)new_hum_x10;
        first_run = 0;
    }
    else
    {
        error = (int32_t)new_hum_x10 - filtered_hum_x10;

        filtered_hum_x10 = filtered_hum_x10 +
                           ((EMA_ALPHA_NUM * error) / EMA_ALPHA_DEN);
    }

    if (filtered_hum_x10 < 0)
    {
        filtered_hum_x10 = 0;
    }

    if (filtered_hum_x10 > 1000)
    {
        filtered_hum_x10 = 1000;
    }

    return (uint32_t)filtered_hum_x10;
}

/* ================= FINAL FILTERED SHT3X READ ================= */

uint8_t sht3x_read_filtered(uint8_t address,
                            int32_t *raw_filtered_temp_x10,
                            uint32_t *raw_filtered_hum_x10,
                            int32_t *final_temp_x10,
                            uint32_t *final_hum_x10)
{
    int32_t dummy_temp;
    uint32_t dummy_hum;

    int32_t t1, t2, t3, t4, t5;
    uint32_t h1, h2, h3, h4, h5;

    int32_t temp_trimmed;
    uint32_t hum_trimmed;

    /*
       First reading after MOSFET power ON is discarded.
       This helps after sensor power switching.
    */

    if (!sht3x_read_temp_humidity(address, &dummy_temp, &dummy_hum))
    {
        return 0;
    }

    delay_ms(50);

    if (!sht3x_read_temp_humidity(address, &t1, &h1)) return 0;
    delay_ms(50);

    if (!sht3x_read_temp_humidity(address, &t2, &h2)) return 0;
    delay_ms(50);

    if (!sht3x_read_temp_humidity(address, &t3, &h3)) return 0;
    delay_ms(50);

    if (!sht3x_read_temp_humidity(address, &t4, &h4)) return 0;
    delay_ms(50);

    if (!sht3x_read_temp_humidity(address, &t5, &h5)) return 0;

    temp_trimmed = trimmed_mean5_int(t1, t2, t3, t4, t5);
    hum_trimmed  = trimmed_mean5_uint(h1, h2, h3, h4, h5);

    *raw_filtered_temp_x10 = temp_trimmed;
    *raw_filtered_hum_x10  = hum_trimmed;

    *final_temp_x10 = ema_filter_temperature_x10(temp_trimmed);
    *final_hum_x10  = ema_filter_humidity_x10(hum_trimmed);

    return 1;
}

/* ================= MAIN ================= */

int main(void)
{
    int32_t raw_temp_x10;
    uint32_t raw_hum_x10;

    int32_t final_temp_x10;
    uint32_t final_hum_x10;

    WDTCTL = WDTPW | WDTHOLD;

    clock_init();
    uart_init();

    sht3x_power_init();
    i2c_release_pins();

    uart_puts("\r\nSHT3X + BSS138 + Filter Code Started\r\n");
    uart_puts("MOSFET Gate = P1.4\r\n");
    uart_puts("SCL = P1.6, SDA = P1.7\r\n");
    uart_puts("Filter = Trimmed mean + EMA\r\n");
    uart_puts("Calibration = Not applied, factory calibrated output used\r\n");

    while (1)
    {
        uart_puts("\r\n-----------------------------\r\n");

        /* ---------- SENSOR OFF ---------- */

        i2c_release_pins();
        sht3x_power_off();

        uart_puts("SHT3X OFF\r\n");
        delay_ms(1000);

        /* ---------- SENSOR ON ---------- */

        uart_puts("SHT3X ON\r\n");

        sht3x_power_on();

        // Wait for sensor power stabilization
        delay_ms(300);

        // Recover and initialize I2C after power ON
        i2c_bus_recover();
        i2c_init();

        if (sht3x_read_filtered(SHT3X_ADDR_1,
                                &raw_temp_x10,
                                &raw_hum_x10,
                                &final_temp_x10,
                                &final_hum_x10))
        {
            uart_puts("SHT3X address: 0x44\r\n");

            uart_puts("Raw filtered temperature = ");
            uart_print_int_x10(raw_temp_x10);
            uart_puts(" C\r\n");

            uart_puts("Raw filtered humidity = ");
            uart_print_uint_x10(raw_hum_x10);
            uart_puts(" %RH\r\n");

            uart_puts("Final temperature = ");
            uart_print_int_x10(final_temp_x10);
            uart_puts(" C\r\n");

            uart_puts("Final humidity = ");
            uart_print_uint_x10(final_hum_x10);
            uart_puts(" %RH\r\n");
        }
        else if (sht3x_read_filtered(SHT3X_ADDR_2,
                                     &raw_temp_x10,
                                     &raw_hum_x10,
                                     &final_temp_x10,
                                     &final_hum_x10))
        {
            uart_puts("SHT3X address: 0x45\r\n");

            uart_puts("Raw filtered temperature = ");
            uart_print_int_x10(raw_temp_x10);
            uart_puts(" C\r\n");

            uart_puts("Raw filtered humidity = ");
            uart_print_uint_x10(raw_hum_x10);
            uart_puts(" %RH\r\n");

            uart_puts("Final temperature = ");
            uart_print_int_x10(final_temp_x10);
            uart_puts(" C\r\n");

            uart_puts("Final humidity = ");
            uart_print_uint_x10(final_hum_x10);
            uart_puts(" %RH\r\n");
        }
        else
        {
            uart_puts("SHT3X read failed\r\n");
        }

        /* ---------- SENSOR OFF AFTER READING ---------- */

        i2c_release_pins();
        sht3x_power_off();

        uart_puts("SHT3X OFF after reading\r\n");

        delay_ms(3000);
    }
}
