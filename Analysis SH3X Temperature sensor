#include <msp430.h>
#include <stdint.h>

/*
   SHT3X air temperature raw vs filtered comparison test
   MCU: MSP430G2553
   IDE: Code Composer Studio

   CSV output:
   sample,raw_air_temp_C,ema_air_temp_C,status

   SHT3X sensor power is controlled using BSS138 MOSFET on P2.5.
   I2C pins:
   SCL = P1.6
   SDA = P1.7

   UART TX:
   P1.2, 9600 baud

   This code prints temperature only.
   Humidity is read internally because SHT3X returns temp + RH together,
   but only temperature is printed for this test.
*/

/* ================= PIN DEFINITIONS ================= */

#define UART_TX_PIN          BIT2      // P1.2 -> UART TX

#define I2C_SCL_PIN          BIT6      // P1.6 -> I2C SCL
#define I2C_SDA_PIN          BIT7      // P1.7 -> I2C SDA

#define SHT3X_MOSFET_PIN     BIT5      // P2.5 -> BSS138 gate for SHT3X power

/* ================= SHT3X SETTINGS ================= */

#define SHT3X_ADDR           0x44      // Common SHT3X address

/*
   SHT3X command:
   0x2400 = high repeatability, clock stretching disabled
*/
#define SHT3X_CMD_MSB        0x24
#define SHT3X_CMD_LSB        0x00

/* ================= TEST SETTINGS ================= */

#define TOTAL_SAMPLES        100
#define SAMPLE_DELAY_MS      1000

/* ================= FILTER SETTINGS ================= */

/*
   EMA alpha = 0.2
   filtered = 0.2 * new + 0.8 * old
*/

#define TEMP_EMA_NEW_WEIGHT  2
#define TEMP_EMA_OLD_WEIGHT  8

/* ================= GLOBAL VARIABLES ================= */

int32_t air_temp_ema_x10 = 0;
uint8_t air_temp_ema_initialized = 0;

/* ================= DELAY FUNCTIONS ================= */

void delay_us(uint16_t us)
{
    while (us--)
    {
        __delay_cycles(1);       // 1 MHz clock -> 1 us
    }
}

void delay_ms(uint16_t ms)
{
    while (ms--)
    {
        __delay_cycles(1000);    // 1 MHz clock -> 1 ms
    }
}

/* ================= CLOCK INIT ================= */

void clock_init(void)
{
    WDTCTL = WDTPW | WDTHOLD;    // Stop watchdog timer

    if (CALBC1_1MHZ != 0xFF)
    {
        DCOCTL = 0;
        BCSCTL1 = CALBC1_1MHZ;
        DCOCTL = CALDCO_1MHZ;
    }
}

/* ================= UART FUNCTIONS ================= */

void uart_init(void)
{
    /*
       UART TX only
       P1.2 = UCA0TXD
       Baud rate = 9600
       Clock = 1 MHz SMCLK
    */

    P1SEL  |= UART_TX_PIN;
    P1SEL2 |= UART_TX_PIN;

    UCA0CTL1 |= UCSWRST;
    UCA0CTL1 |= UCSSEL_2;       // SMCLK

    UCA0BR0 = 104;              // 1 MHz / 9600
    UCA0BR1 = 0;
    UCA0MCTL = UCBRS0;

    UCA0CTL1 &= ~UCSWRST;
}

void uart_putc(char c)
{
    while (!(IFG2 & UCA0TXIFG));
    UCA0TXBUF = c;
}

void uart_puts(const char *str)
{
    while (*str)
    {
        uart_putc(*str++);
    }
}

void uart_print_uint32(uint32_t value)
{
    char buffer[11];
    uint8_t i = 0;

    if (value == 0)
    {
        uart_putc('0');
        return;
    }

    while (value > 0)
    {
        buffer[i++] = (char)((value % 10) + '0');
        value /= 10;
    }

    while (i > 0)
    {
        uart_putc(buffer[--i]);
    }
}

void uart_print_uint16(uint16_t value)
{
    uart_print_uint32((uint32_t)value);
}

void uart_print_int_x10(int32_t value_x10)
{
    /*
       Print signed x10 fixed-point value.

       Example:
       253  -> 25.3
       -45  -> -4.5
    */

    if (value_x10 < 0)
    {
        uart_putc('-');
        value_x10 = -value_x10;
    }

    uart_print_uint32((uint32_t)(value_x10 / 10));
    uart_putc('.');
    uart_print_uint32((uint32_t)(value_x10 % 10));
}

/* ================= SHT3X POWER CONTROL ================= */

void sht3x_power_init(void)
{
    /*
       BSS138 gate control.

       P2.5 HIGH = SHT3X sensor ON
       P2.5 LOW  = SHT3X sensor OFF
    */

    P2SEL  &= ~SHT3X_MOSFET_PIN;
    P2SEL2 &= ~SHT3X_MOSFET_PIN;

    P2OUT &= ~SHT3X_MOSFET_PIN;     // OFF at startup
    P2DIR |= SHT3X_MOSFET_PIN;
}

void sht3x_power_on(void)
{
    P2OUT |= SHT3X_MOSFET_PIN;
}

void sht3x_power_off(void)
{
    P2OUT &= ~SHT3X_MOSFET_PIN;
}

/* ================= I2C FUNCTIONS ================= */

void i2c_init(void)
{
    /*
       MSP430G2553 USCI_B0 I2C
       SCL = P1.6
       SDA = P1.7
       I2C speed approximately 100 kHz with 1 MHz SMCLK.
    */

    P1SEL  |= I2C_SCL_PIN | I2C_SDA_PIN;
    P1SEL2 |= I2C_SCL_PIN | I2C_SDA_PIN;

    UCB0CTL1 |= UCSWRST;

    UCB0CTL0 = UCMST | UCMODE_3 | UCSYNC;    // I2C master, synchronous
    UCB0CTL1 = UCSWRST | UCSSEL_2;           // SMCLK

    UCB0BR0 = 10;               // 1 MHz / 10 = 100 kHz
    UCB0BR1 = 0;

    UCB0I2CSA = SHT3X_ADDR;

    UCB0CTL1 &= ~UCSWRST;

    IFG2 &= ~(UCB0TXIFG | UCB0RXIFG);
}

uint8_t i2c_wait_tx_flag(void)
{
    uint16_t timeout = 50000;

    while (!(IFG2 & UCB0TXIFG))
    {
        if (UCB0STAT & UCNACKIFG)
        {
            UCB0STAT &= ~UCNACKIFG;
            return 0;
        }

        timeout--;

        if (timeout == 0)
        {
            return 0;
        }
    }

    return 1;
}

uint8_t i2c_wait_rx_flag(void)
{
    uint16_t timeout = 50000;

    while (!(IFG2 & UCB0RXIFG))
    {
        if (UCB0STAT & UCNACKIFG)
        {
            UCB0STAT &= ~UCNACKIFG;
            return 0;
        }

        timeout--;

        if (timeout == 0)
        {
            return 0;
        }
    }

    return 1;
}

uint8_t i2c_write_2_bytes(uint8_t address, uint8_t data1, uint8_t data2)
{
    uint16_t timeout;

    while (UCB0CTL1 & UCTXSTP);

    UCB0I2CSA = address;
    UCB0STAT &= ~UCNACKIFG;

    UCB0CTL1 |= UCTR | UCTXSTT;     // TX mode + START

    if (!i2c_wait_tx_flag())
    {
        UCB0CTL1 |= UCTXSTP;
        return 0;
    }

    UCB0TXBUF = data1;

    if (!i2c_wait_tx_flag())
    {
        UCB0CTL1 |= UCTXSTP;
        return 0;
    }

    UCB0TXBUF = data2;

    if (!i2c_wait_tx_flag())
    {
        UCB0CTL1 |= UCTXSTP;
        return 0;
    }

    UCB0CTL1 |= UCTXSTP;

    timeout = 50000;
    while (UCB0CTL1 & UCTXSTP)
    {
        timeout--;

        if (timeout == 0)
        {
            return 0;
        }
    }

    return 1;
}

uint8_t i2c_read_6_bytes(uint8_t address, uint8_t data[6])
{
    /*
       Read 6 bytes from SHT3X:
       T_MSB, T_LSB, T_CRC, RH_MSB, RH_LSB, RH_CRC
    */

    uint8_t i;
    uint16_t timeout;

    while (UCB0CTL1 & UCTXSTP);

    UCB0I2CSA = address;
    UCB0STAT &= ~UCNACKIFG;

    UCB0CTL1 &= ~UCTR;             // RX mode
    UCB0CTL1 |= UCTXSTT;           // START

    timeout = 50000;
    while (UCB0CTL1 & UCTXSTT)
    {
        if (UCB0STAT & UCNACKIFG)
        {
            UCB0STAT &= ~UCNACKIFG;
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }

        timeout--;

        if (timeout == 0)
        {
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }
    }

    for (i = 0; i < 6; i++)
    {
        /*
           For multi-byte receive on USCI_B0, set STOP before reading
           the final byte. Here final byte index is 5, so set STOP
           after byte index 4 is ready but before reading byte index 5.
        */

        if (i == 5)
        {
            UCB0CTL1 |= UCTXSTP;
        }

        if (!i2c_wait_rx_flag())
        {
            UCB0CTL1 |= UCTXSTP;
            return 0;
        }

        data[i] = UCB0RXBUF;
    }

    timeout = 50000;
    while (UCB0CTL1 & UCTXSTP)
    {
        timeout--;

        if (timeout == 0)
        {
            return 0;
        }
    }

    return 1;
}

/* ================= SHT3X FUNCTIONS ================= */

uint8_t sht3x_crc8(uint8_t msb, uint8_t lsb)
{
    /*
       SHT3X CRC:
       polynomial = 0x31
       initialization = 0xFF
    */

    uint8_t crc = 0xFF;
    uint8_t data[2];
    uint8_t byte_index;
    uint8_t bit_index;

    data[0] = msb;
    data[1] = lsb;

    for (byte_index = 0; byte_index < 2; byte_index++)
    {
        crc ^= data[byte_index];

        for (bit_index = 0; bit_index < 8; bit_index++)
        {
            if (crc & 0x80)
            {
                crc = (uint8_t)((crc << 1) ^ 0x31);
            }
            else
            {
                crc <<= 1;
            }
        }
    }

    return crc;
}

uint8_t sht3x_read_temperature_x10(int32_t *temperature_x10)
{
    uint8_t data[6];
    uint16_t raw_temp;
    uint8_t calc_crc;

    /*
       Send measurement command.
    */

    if (!i2c_write_2_bytes(SHT3X_ADDR, SHT3X_CMD_MSB, SHT3X_CMD_LSB))
    {
        return 0;
    }

    /*
       High repeatability measurement time is around 15 ms.
       Use 20 ms for safety.
    */

    delay_ms(20);

    if (!i2c_read_6_bytes(SHT3X_ADDR, data))
    {
        return 0;
    }

    /*
       Validate temperature CRC.
       data[0] = T_MSB
       data[1] = T_LSB
       data[2] = T_CRC
    */

    calc_crc = sht3x_crc8(data[0], data[1]);

    if (calc_crc != data[2])
    {
        return 0;
    }

    raw_temp = ((uint16_t)data[0] << 8) | data[1];

    /*
       SHT3X temperature equation:
       T_C = -45 + 175 * raw / 65535

       x10 integer:
       T_x10 = -450 + 1750 * raw / 65535
    */

    *temperature_x10 = -450 + (((int32_t)1750 * (int32_t)raw_temp) / 65535);

    /*
       Sanity check for normal environmental range.
       For chamber testing, -10.0 C to 80.0 C is enough.
    */

    if (*temperature_x10 < -100)
    {
        return 0;
    }

    if (*temperature_x10 > 800)
    {
        return 0;
    }

    return 1;
}

int32_t temp_apply_ema_x10(int32_t new_temp_x10)
{
    /*
       EMA filter:
       alpha = 0.2

       First valid reading initializes the EMA.
    */

    if (!air_temp_ema_initialized)
    {
        air_temp_ema_x10 = new_temp_x10;
        air_temp_ema_initialized = 1;
    }
    else
    {
        air_temp_ema_x10 =
            ((TEMP_EMA_NEW_WEIGHT * new_temp_x10) +
             (TEMP_EMA_OLD_WEIGHT * air_temp_ema_x10)) /
            (TEMP_EMA_NEW_WEIGHT + TEMP_EMA_OLD_WEIGHT);
    }

    return air_temp_ema_x10;
}

/* ================= MAIN ================= */

int main(void)
{
    uint16_t sample_number;

    int32_t raw_air_temp_x10;
    int32_t ema_air_temp_x10;

    uint8_t status;

    clock_init();
    uart_init();
    sht3x_power_init();

    uart_puts("\r\n============================================================\r\n");
    uart_puts("SHT3X TEMPERATURE RAW VS EMA FILTERED TEST\r\n");
    uart_puts("I2C SCL: P1.6\r\n");
    uart_puts("I2C SDA: P1.7\r\n");
    uart_puts("SHT3X BSS138 MOSFET gate: P2.5\r\n");
    uart_puts("UART TX: P1.2, 9600 baud\r\n");
    uart_puts("Filter: CRC validation + EMA alpha 0.2\r\n");
    uart_puts("============================================================\r\n");

    sht3x_power_on();

    uart_puts("SHT3X sensor ON\r\n");
    uart_puts("Waiting 300 ms for sensor power stabilization...\r\n");
    delay_ms(300);

    i2c_init();

    uart_puts("\r\nsample,raw_air_temp_C,ema_air_temp_C,status\r\n");

    for (sample_number = 1; sample_number <= TOTAL_SAMPLES; sample_number++)
    {
        raw_air_temp_x10 = 0;
        ema_air_temp_x10 = 0;
        status = 0;

        if (sht3x_read_temperature_x10(&raw_air_temp_x10))
        {
            ema_air_temp_x10 = temp_apply_ema_x10(raw_air_temp_x10);
            status = 1;
        }
        else
        {
            /*
               If reading fails, keep previous EMA value.
               If EMA has not been initialized, print 0.0.
            */

            if (air_temp_ema_initialized)
            {
                ema_air_temp_x10 = air_temp_ema_x10;
            }

            status = 0;
        }

        uart_print_uint16(sample_number);
        uart_putc(',');

        uart_print_int_x10(raw_air_temp_x10);
        uart_putc(',');

        uart_print_int_x10(ema_air_temp_x10);
        uart_putc(',');

        uart_print_uint32(status);
        uart_puts("\r\n");

        delay_ms(SAMPLE_DELAY_MS);
    }

    sht3x_power_off();

    uart_puts("\r\nTest complete. SHT3X sensor OFF.\r\n");

    while (1)
    {
        __bis_SR_register(LPM4_bits);
    }
}
